// 1.0.0.7: version information and manifest of a Windows program (configured by CMakeLists.txt).
#include <winver.h>

1 24 "@VROST_RC_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VROST_RC_VERSION_COMMAS@
PRODUCTVERSION @VROST_RC_VERSION_COMMAS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "VROSTBridge"
      VALUE "FileDescription", "@VROST_RC_DESCRIPTION@"
      VALUE "FileVersion", "@VROSTBRIDGE_VERSION@"
      VALUE "InternalName", "@VROST_RC_NAME@"
      VALUE "LegalCopyright", "Copyright (c) 2026 JagerBombastic. MIT licence"
      VALUE "OriginalFilename", "@VROST_RC_NAME@.exe"
      VALUE "ProductName", "VROSTBridge"
      VALUE "ProductVersion", "@VROSTBRIDGE_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
