+// VROSTBridge: negotiation helpers shared with vrostbridge_init, which derives the same
+// headset configuration before SteamVR starts (see that module).
+pub(crate) fn view_resolution(config: FrameSize, default_res: UVec2) -> UVec2 {
+    let res = match config {
+        FrameSize::Scale(scale) => default_res.as_vec2() * scale,
+        FrameSize::Absolute { width, height } => {
+            let width = width as f32;
+            Vec2::new(
+                width,
+                height.map_or_else(
+                    || {
+                        let default_res = default_res.as_vec2();
+                        width * default_res.y / default_res.x
+                    },
+                    |h| h as f32,
+                ),
+            )
+        }
+    };
+
+    UVec2::new(align32(res.x), align32(res.y))
+}
+
+/// Largest resolution at the same aspect ratio that the client supports.
+pub(crate) fn clamp_view_resolution(resolution: UVec2, max_view_resolution: UVec2) -> UVec2 {
+    if resolution.x <= max_view_resolution.x && resolution.y <= max_view_resolution.y {
+        return resolution;
+    }
+    let transcoding_ratio = resolution.x as f32 / resolution.y as f32;
+    if transcoding_ratio > max_view_resolution.x as f32 / max_view_resolution.y as f32 {
+        UVec2::new(
+            align32(max_view_resolution.x as f32),
+            align32(max_view_resolution.x as f32 / transcoding_ratio),
+        )
+    } else {
+        UVec2::new(
+            align32(max_view_resolution.y as f32 * transcoding_ratio),
+            align32(max_view_resolution.y as f32),
+        )
+    }
+}
+
+/// The client refresh rate closest to the preferred one (first wins on a tie).
+pub(crate) fn best_refresh_rate(refresh_rates: &[f32], preferred_fps: f32) -> f32 {
+    let mut best_match = 0_f32;
+    let mut min_diff = f32::MAX;
+    for rate in refresh_rates {
+        let diff = (*rate - preferred_fps).abs();
+        if diff < min_diff {
+            best_match = *rate;
+            min_diff = diff;
+        }
+    }
+    best_match
+}
