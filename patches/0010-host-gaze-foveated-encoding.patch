index 00000000..26f48a92
--- /dev/null
+++ b/alvr/server_openvr/src/vrostbridge_foveation.rs
@@ -0,0 +1,277 @@
+//! VROSTBridge: gaze-driven foveated encoding centres.
+//!
+//! The pinned host already compresses the periphery of each eye before encoding and
+//! sends the centre positions with every frame, so the client can undo it exactly.
+//! Upstream keeps those centres fixed. With an eye tracker (for example a Bigscreen
+//! Beyond 2e) the full-resolution region can instead follow the user's gaze, which
+//! allows a smaller sharp region and much stronger compression without visible loss.
+//!
+//! For each frame the encoder asks for the centre shifts. This module converts the
+//! latest head-relative gaze direction into each eye's image coordinates using that
+//! eye's pose and field of view, then into ALVR's centre-shift units:
+//! - the right eye uses horizontally mirrored coordinates, like the compression shader;
+//! - shifts are snapped to the same pixel grid the negotiation uses, so region borders
+//!   stay on whole compressed pixels and the client's inverse stays well conditioned;
+//! - small gaze movements inside a dead band keep the previous centre (no shimmer);
+//! - stale or missing gaze returns to the negotiated fixed centre.
+
+use alvr_common::{
+    ViewParams,
+    glam::{Quat, Vec3},
+};
+use std::time::{Duration, Instant};
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct FoveationGeometry {
+    /// Transcoded eye resolution in pixels (before compression).
+    pub eye_resolution: [f32; 2],
+    /// Negotiated, already aligned centre size per axis.
+    pub center_size: [f32; 2],
+    pub edge_ratio: [f32; 2],
+}
+
+/// Normalised image position (u right, v down, both 0..1) of a head-relative gaze
+/// orientation in one eye's view. None if the gaze points outside the view frustum.
+pub fn eye_image_position(gaze: Quat, view: &ViewParams) -> Option<[f32; 2]> {
+    let direction = gaze * Vec3::NEG_Z;
+    let local = view.pose.orientation.inverse() * direction;
+    if !local.is_finite() || local.z > -1e-3 {
+        return None;
+    }
+    let tx = local.x / -local.z;
+    let ty = local.y / -local.z;
+    let (left, right) = (view.fov.left.tan(), view.fov.right.tan());
+    let (up, down) = (view.fov.up.tan(), view.fov.down.tan());
+    if !(right > left && up > down) {
+        return None;
+    }
+    let u = (tx - left) / (right - left);
+    let v = (up - ty) / (up - down);
+    (u.is_finite() && v.is_finite()).then(|| [u.clamp(0.0, 1.0), v.clamp(0.0, 1.0)])
+}
+
+/// Alignment step of the centre shift on one axis (see the negotiation in server_core).
+pub fn shift_step(resolution: f32, center_size: f32, edge_ratio: f32) -> Option<f32> {
+    let edge_size = resolution - center_size * resolution;
+    let step = edge_ratio * 2.0 / edge_size;
+    (edge_size > 0.0 && edge_ratio > 0.0 && step.is_finite() && step > 0.0 && step < 1.0)
+        .then_some(step)
+}
+
+/// Centre shift that puts the middle of the full-resolution region at `position`
+/// (0..1, already mirrored for the right eye), snapped and clamped like the negotiation.
+pub fn aligned_shift(position: f32, resolution: f32, center_size: f32, edge_ratio: f32) -> f32 {
+    let Some(step) = shift_step(resolution, center_size, edge_ratio) else {
+        return 0.0;
+    };
+    let c0 = (1.0 - center_size) / 2.0;
+    if c0 <= 0.0 {
+        return 0.0;
+    }
+    let shift = (position - 0.5) / c0;
+    let snapped = (shift / step).round() * step;
+    snapped.clamp(-1.0 + step, 1.0 - step)
+}
+
+/// Middle of the full-resolution region for a shift, in the shift's own (mirrored) coordinates.
+pub fn region_middle(shift: f32, center_size: f32) -> f32 {
+    0.5 + (1.0 - center_size) / 2.0 * shift
+}
+
+/// Shifts for both eyes from a gaze direction, or None if it is outside either view.
+pub fn gaze_shifts(
+    gaze: Quat,
+    views: &[ViewParams; 2],
+    geometry: &FoveationGeometry,
+) -> Option<[[f32; 2]; 2]> {
+    let mut shifts = [[0.0; 2]; 2];
+    for (eye, view) in views.iter().enumerate() {
+        let [u, v] = eye_image_position(gaze, view)?;
+        // The compression shader mirrors the right eye horizontally.
+        let x = if eye == 1 { 1.0 - u } else { u };
+        for (axis, position) in [x, v].into_iter().enumerate() {
+            shifts[eye][axis] = aligned_shift(
+                position,
+                geometry.eye_resolution[axis],
+                geometry.center_size[axis],
+                geometry.edge_ratio[axis],
+            );
+        }
+    }
+    Some(shifts)
+}
+
+#[derive(Default)]
+pub struct DynamicFoveation {
+    current: Option<[[f32; 2]; 2]>,
+    pub gaze_frames: u64,
+    pub fallback_frames: u64,
+    pub moves: u64,
+    last_log: Option<Instant>,
+}
+
+pub struct FrameInput<'a> {
+    pub gaze: Option<(Quat, Instant)>,
+    pub views: &'a [ViewParams; 2],
+    pub geometry: FoveationGeometry,
+    pub defaults: [[f32; 2]; 2],
+    pub deadband: f32,
+    pub stale: Duration,
+    pub now: Instant,
+}
+
+impl DynamicFoveation {
+    /// Centre shifts for this frame.
+    pub fn update(&mut self, input: &FrameInput) -> [[f32; 2]; 2] {
+        let fresh_gaze = input
+            .gaze
+            .filter(|(_, received)| input.now.saturating_duration_since(*received) <= input.stale);
+        let target = fresh_gaze.and_then(|(gaze, _)| gaze_shifts(gaze, input.views, &input.geometry));
+        let Some(target) = target else {
+            self.fallback_frames += 1;
+            self.current = None;
+            return input.defaults;
+        };
+        self.gaze_frames += 1;
+        let moved = match self.current {
+            None => true,
+            Some(current) => (0..2).any(|eye| {
+                (0..2).any(|axis| {
+                    let size = input.geometry.center_size[axis];
+                    (region_middle(target[eye][axis], size) - region_middle(current[eye][axis], size))
+                        .abs()
+                        > input.deadband
+                })
+            }),
+        };
+        if moved {
+            self.moves += 1;
+            self.current = Some(target);
+        }
+        self.current.unwrap_or(target)
+    }
+
+    /// True at most every five seconds, for a periodic diagnostic line.
+    pub fn should_log(&mut self, now: Instant) -> bool {
+        let due = self
+            .last_log
+            .is_none_or(|last| now.saturating_duration_since(last) >= Duration::from_secs(5));
+        if due {
+            self.last_log = Some(now);
+        }
+        due
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use alvr_common::{Fov, Pose};
+
+    fn view(yaw_deg: f32) -> ViewParams {
+        ViewParams {
+            pose: Pose {
+                orientation: Quat::from_rotation_y(yaw_deg.to_radians()),
+                position: Vec3::ZERO,
+            },
+            fov: Fov {
+                left: (-50f32).to_radians(),
+                right: 45f32.to_radians(),
+                up: 48f32.to_radians(),
+                down: (-52f32).to_radians(),
+            },
+        }
+    }
+
+    fn geometry() -> FoveationGeometry {
+        FoveationGeometry {
+            eye_resolution: [2560.0, 2560.0],
+            center_size: [0.4, 0.4],
+            edge_ratio: [4.0, 4.0],
+        }
+    }
+
+    #[test]
+    fn straight_ahead_maps_to_the_projection_centre() {
+        let [u, v] = eye_image_position(Quat::IDENTITY, &view(0.0)).unwrap();
+        let left = (-50f32).to_radians().tan();
+        let right = 45f32.to_radians().tan();
+        assert!((u - (0.0 - left) / (right - left)).abs() < 1e-5);
+        let up = 48f32.to_radians().tan();
+        let down = (-52f32).to_radians().tan();
+        assert!((v - up / (up - down)).abs() < 1e-5);
+    }
+
+    #[test]
+    fn looking_right_moves_right_and_up_moves_up() {
+        let base = eye_image_position(Quat::IDENTITY, &view(0.0)).unwrap();
+        let right = eye_image_position(Quat::from_rotation_y((-20f32).to_radians()), &view(0.0)).unwrap();
+        let up = eye_image_position(Quat::from_rotation_x(15f32.to_radians()), &view(0.0)).unwrap();
+        assert!(right[0] > base[0] + 0.1);
+        assert!(up[1] < base[1] - 0.1);
+        // Looking backwards is outside the frustum.
+        assert!(eye_image_position(Quat::from_rotation_y(std::f32::consts::PI), &view(0.0)).is_none());
+    }
+
+    #[test]
+    fn eye_rotation_is_respected() {
+        // A display canted 10 degrees outward sees a straight-ahead gaze 10 degrees inward.
+        let canted = eye_image_position(Quat::IDENTITY, &view(10.0)).unwrap();
+        let flat = eye_image_position(Quat::IDENTITY, &view(0.0)).unwrap();
+        assert!(canted[0] > flat[0]);
+    }
+
+    #[test]
+    fn shifts_are_aligned_clamped_and_centred() {
+        let g = geometry();
+        let step = shift_step(2560.0, 0.4, 4.0).unwrap();
+        assert!((step - 8.0 / 1536.0).abs() < 1e-7);
+        assert_eq!(aligned_shift(0.5, 2560.0, 0.4, 4.0), 0.0);
+        let shift = aligned_shift(0.63, 2560.0, 0.4, 4.0);
+        assert!(((shift / step) - (shift / step).round()).abs() < 1e-3, "on the grid");
+        assert!((region_middle(shift, 0.4) - 0.63).abs() <= step * 0.3 / 2.0 + 1e-4);
+        assert!((aligned_shift(1.0, 2560.0, 0.4, 4.0) - (1.0 - step)).abs() < 1e-6);
+        assert!((aligned_shift(0.0, 2560.0, 0.4, 4.0) + (1.0 - step)).abs() < 1e-6);
+        // Degenerate geometry keeps the centre.
+        assert_eq!(aligned_shift(0.9, 2560.0, 1.0, 4.0), 0.0);
+        let shifts = gaze_shifts(Quat::from_rotation_y((-15f32).to_radians()), &[view(0.0), view(0.0)], &g).unwrap();
+        // Looking right: the left eye's region moves right (positive), the right eye's
+        // mirrored coordinate moves the other way (negative).
+        assert!(shifts[0][0] > 0.0);
+        assert!(shifts[1][0] < shifts[0][0]);
+    }
+
+    #[test]
+    fn dead_band_stale_gaze_and_fallback() {
+        let views = [view(0.0), view(0.0)];
+        let defaults = [[0.1, 0.05], [0.1, 0.05]];
+        let now = Instant::now();
+        let mut state = DynamicFoveation::default();
+        let mut input = FrameInput {
+            gaze: Some((Quat::from_rotation_y((-10f32).to_radians()), now)),
+            views: &views,
+            geometry: geometry(),
+            defaults,
+            deadband: 0.03,
+            stale: Duration::from_millis(150),
+            now,
+        };
+        let first = state.update(&input);
+        assert_ne!(first, defaults);
+        // A tiny movement stays put.
+        input.gaze = Some((Quat::from_rotation_y((-10.5f32).to_radians()), now));
+        assert_eq!(state.update(&input), first);
+        // A big movement moves.
+        input.gaze = Some((Quat::from_rotation_y((-25f32).to_radians()), now));
+        let moved = state.update(&input);
+        assert_ne!(moved, first);
+        // Stale gaze returns to the fixed centre.
+        input.now = now + Duration::from_millis(200);
+        assert_eq!(state.update(&input), defaults);
+        // No gaze at all also uses the fixed centre.
+        input.gaze = None;
+        assert_eq!(state.update(&input), defaults);
+        assert_eq!(state.fallback_frames, 2);
+        assert_eq!(state.moves, 2);
+    }
+}
