+/// VROSTBridge: per-frame foveation centres. `shifts` holds the negotiated left/right X/Y
+/// centres on input and receives the centres to use. Returns false (nothing changed) when
+/// gaze-driven foveation is off for this session.
+#[unsafe(export_name = "VROSTBridgeFoveationShifts")]
+extern "C" fn vrostbridge_foveation_shifts(
+    eye_width: u32,
+    eye_height: u32,
+    center_size: *const f32,
+    edge_ratio: *const f32,
+    shifts: *mut f32,
+) -> bool {
+    use vrostbridge_foveation::{FoveationGeometry, FrameInput};
+
+    let config = alvr_server_core::vrostbridge_stream::current();
+    if !config.gaze_foveation || center_size.is_null() || edge_ratio.is_null() || shifts.is_null() {
+        return false;
+    }
+    // SAFETY: the C++ caller passes two-element size/ratio arrays and a four-element shift array.
+    let (center_size, edge_ratio, io) = unsafe {
+        (
+            std::slice::from_raw_parts(center_size, 2),
+            std::slice::from_raw_parts(edge_ratio, 2),
+            std::slice::from_raw_parts_mut(shifts, 4),
+        )
+    };
+    let defaults = [[io[0], io[1]], [io[2], io[3]]];
+    let views = *LOCAL_VIEW_PARAMS.read();
+    let now = Instant::now();
+    let input = FrameInput {
+        gaze: alvr_server_core::vrostbridge_gaze::latest()
+            .map(|sample| (sample.orientation, sample.received)),
+        views: &views,
+        geometry: FoveationGeometry {
+            eye_resolution: [eye_width as f32, eye_height as f32],
+            center_size: [center_size[0], center_size[1]],
+            edge_ratio: [edge_ratio[0], edge_ratio[1]],
+        },
+        defaults,
+        deadband: config.gaze_deadband,
+        stale: Duration::from_millis(u64::from(config.gaze_stale_ms)),
+        now,
+    };
+    let mut guard = VROST_FOVEATION.lock();
+    let state = guard.get_or_insert_with(Default::default);
+    let result = state.update(&input);
+    if result.iter().flatten().any(|value| !value.is_finite()) {
+        return false;
+    }
+    io.copy_from_slice(&[result[0][0], result[0][1], result[1][0], result[1][1]]);
+    if state.should_log(now) {
+        alvr_common::info!(
+            "VROST_GAZE_FOVEATION gaze_frames={} fallback_frames={} moves={} left={:.3},{:.3} right={:.3},{:.3}",
+            state.gaze_frames,
+            state.fallback_frames,
+            state.moves,
+            io[0],
+            io[1],
+            io[2],
+            io[3]
+        );
+    }
+    true
+}
