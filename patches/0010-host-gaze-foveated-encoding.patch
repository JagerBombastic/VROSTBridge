+//! VROSTBridge: latest combined eye-gaze direction received from the client.
+//!
+//! The client sends the calibrated combined gaze (a head-relative orientation, the
+//! `eyes_combined` face-tracking field) with each tracking packet when an eye tracker
+//! is active. Face-tracking sinks only forward it when a sink is configured; gaze-
+//! driven foveated encoding needs the latest value regardless, so it is kept here
+//! with the time it arrived.
+
+use alvr_common::{glam::Quat, parking_lot::Mutex};
+use std::time::Instant;
+
+#[derive(Clone, Copy, Debug)]
+pub struct GazeSample {
+    pub received: Instant,
+    pub orientation: Quat,
+}
+
+static LATEST: Mutex<Option<GazeSample>> = Mutex::new(None);
+
+pub fn report(orientation: Quat) {
+    report_at(orientation, Instant::now());
+}
+
+pub fn report_at(orientation: Quat, received: Instant) {
+    if !orientation.is_finite() {
+        return;
+    }
+    let length = orientation.length();
+    if !(0.5..=1.5).contains(&length) {
+        return;
+    }
+    *LATEST.lock() = Some(GazeSample {
+        received,
+        orientation: orientation.normalize(),
+    });
+}
+
+pub fn latest() -> Option<GazeSample> {
+    *LATEST.lock()
+}
+
+pub fn clear() {
+    *LATEST.lock() = None;
+}
