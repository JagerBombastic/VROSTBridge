diff --git a/alvr/server_openvr/cpp/platform/win32/VROSTBridgeColor.h b/alvr/server_openvr/cpp/platform/win32/VROSTBridgeColor.h
new file mode 100644
index 00000000..0f2d6533
--- /dev/null
+++ b/alvr/server_openvr/cpp/platform/win32/VROSTBridgeColor.h
@@ -0,0 +1,132 @@
+#pragma once
+// VROSTBridge (patch 0018): what an RGB to Y'CbCr conversion really produced.
+//
+// Before streaming, the AMD encoder path converts a small test image (black, white, red and
+// mid grey stripes) with the same converter settings it will stream with, reads the result
+// back and classifies it here. The stream is then labelled with the range and matrix the
+// samples really have, so the headset shows black as black. Without this, a converter
+// that quietly produced studio-range samples (16-235) in a stream labelled full range
+// (0-255) turned black into dark grey with 10-bit encoding.
+//
+// No Windows or AMF types, so these rules are tested on any platform.
+#include <cmath>
+#include <cstdint>
+#include <initializer_list>
+
+namespace vrost_color {
+
+// AMF_VIDEO_CONVERTER_COLOR_PROFILE values (AMF ColorSpace.h). VideoEncoderAMF.cpp checks
+// at compile time that they match.
+constexpr int64_t kProfile601 = 0, kProfile709 = 1, kProfile2020 = 2, kProfileFull601 = 3,
+                  kProfileFull709 = 7, kProfileFull2020 = 8;
+
+// The test image: vertical stripes of these sRGB colours, in this order.
+constexpr int kColours = 4;
+constexpr uint8_t kTestColours[kColours][3] = {
+    {0, 0, 0}, {255, 255, 255}, {255, 0, 0}, {128, 128, 128}};
+
+struct Measured {
+    int bits = 0;               // sample depth: 8 (NV12) or 10 (P010)
+    int code[kColours][3] = {}; // Y', Cb, Cr codes for each stripe
+};
+
+struct Verdict {
+    bool known = false;        // range and matrix recognised
+    bool displayable = false;  // the headset client decodes this matrix (BT.709 or BT.601)
+    bool full = false;         // full range (0-255 scaled) rather than studio (16-235 scaled)
+    int matrix = 0;            // 709, 601 or 2020
+    int64_t profile = -1;      // AMF profile describing it, -1 when not known
+    const char* reason = "";   // why it is not known, for the log
+};
+
+inline bool IsFullRangeProfile(int64_t profile) {
+    return profile == kProfileFull601 || profile == kProfileFull709 || profile == kProfileFull2020;
+}
+
+inline int MatrixOfProfile(int64_t profile) {
+    switch (profile) {
+    case kProfile601:
+    case kProfileFull601: return 601;
+    case kProfile2020:
+    case kProfileFull2020: return 2020;
+    default: return 709;
+    }
+}
+
+inline int64_t ProfileFor(bool full, int matrix) {
+    switch (matrix) {
+    case 601: return full ? kProfileFull601 : kProfile601;
+    case 2020: return full ? kProfileFull2020 : kProfile2020;
+    default: return full ? kProfileFull709 : kProfile709;
+    }
+}
+
+inline Verdict Classify(const Measured& m) {
+    Verdict v;
+    if (m.bits != 8 && m.bits != 10) {
+        v.reason = "bit-depth";
+        return v;
+    }
+    const double step = m.bits == 10 ? 4.0 : 1.0; // one 8-bit code at this depth
+    const double tolerance = 3 * step;
+    const double centre = 128 * step;
+    const double top = m.bits == 10 ? 1023.0 : 255.0;
+    const auto within = [&](double value, double target) { // ("near" is a Windows macro)
+        return std::fabs(value - target) <= tolerance;
+    };
+    const int* black = m.code[0];
+    const int* white = m.code[1];
+    const int* red = m.code[2];
+    const int* grey = m.code[3];
+    for (const int* neutral : {black, white, grey}) {
+        if (!within(neutral[1], centre) || !within(neutral[2], centre)) {
+            v.reason = "neutral-has-colour";
+            return v;
+        }
+    }
+    if (within(black[0], 0) && within(white[0], top)) {
+        v.full = true;
+    } else if (within(black[0], 16 * step) && within(white[0], 235 * step)) {
+        v.full = false;
+    } else {
+        v.reason = "black-or-white-level";
+        return v;
+    }
+    const double span = double(white[0] - black[0]);
+    // Mid grey stays in the middle: no tone curve (linearisation, gamma) was applied.
+    if (std::fabs((grey[0] - black[0]) / span - 128.0 / 255.0) > 0.03) {
+        v.reason = "tone-curve";
+        return v;
+    }
+    // The red stripe's share of white's luma names the matrix: Kr.
+    const double share = (red[0] - black[0]) / span;
+    const struct {
+        int matrix;
+        double kr;
+    } matrices[] = {{709, 0.2126}, {601, 0.299}, {2020, 0.2627}};
+    double bestError = 1.0;
+    for (const auto& candidate : matrices) {
+        const double error = std::fabs(share - candidate.kr);
+        if (error < bestError) {
+            bestError = error;
+            v.matrix = candidate.matrix;
+        }
+    }
+    if (bestError > 0.02) {
+        v.reason = "matrix";
+        return v;
+    }
+    // Red carries its colour in Cr, well above the centre, with Cb below it: catches
+    // swapped chroma channels.
+    if (!(red[2] > centre + 64 * step && red[1] < centre)) {
+        v.reason = "chroma-order";
+        return v;
+    }
+    v.known = true;
+    v.displayable = v.matrix == 709 || v.matrix == 601;
+    v.profile = ProfileFor(v.full, v.matrix);
+    if (!v.displayable) v.reason = "matrix-not-decoded-by-client";
+    return v;
+}
+
+} // namespace vrost_color
