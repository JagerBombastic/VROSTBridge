+bool VideoEncoderAMF::ProbeConverter(
+    amf::AMF_SURFACE_FORMAT outputFormat,
+    int64_t profile,
+    vrost_color::Measured& measured,
+    std::string& why
+) {
+    // A small image of vertical stripes, one per test colour. The real stream's converter
+    // has the same settings and differs only in size.
+    constexpr int kStripe = 32, kWidth = kStripe * vrost_color::kColours, kHeight = 64;
+    if (m_surfaceFormat != amf::AMF_SURFACE_RGBA) {
+        why = "input-format";
+        return false;
+    }
+    amf::AMFComponentPtr converter;
+    try {
+        converter = MakeConverter(m_surfaceFormat, kWidth, kHeight, outputFormat, profile);
+        amf::AMFSurfacePtr image;
+        if (m_amfContext->AllocSurface(
+                amf::AMF_MEMORY_HOST, m_surfaceFormat, kWidth, kHeight, &image
+            ) != AMF_OK
+            || !image) {
+            throw MakeException("host-surface");
+        }
+        amf::AMFPlane* plane = image->GetPlaneAt(0);
+        auto* pixels = static_cast<uint8_t*>(plane->GetNative());
+        if (!pixels) throw MakeException("host-surface-memory");
+        const size_t pitch = size_t(plane->GetHPitch());
+        for (int y = 0; y < kHeight; ++y) {
+            for (int x = 0; x < kWidth; ++x) {
+                const uint8_t* colour = vrost_color::kTestColours[x / kStripe];
+                uint8_t* pixel = pixels + y * pitch + size_t(x) * 4; // R, G, B, A bytes
+                pixel[0] = colour[0];
+                pixel[1] = colour[1];
+                pixel[2] = colour[2];
+                pixel[3] = 255;
+            }
+        }
+        if (image->Convert(amf::AMF_MEMORY_DX11) != AMF_OK) throw MakeException("upload");
+        const AMF_RESULT submitted = converter->SubmitInput(image);
+        if (submitted != AMF_OK && submitted != AMF_NEED_MORE_INPUT) {
+            throw MakeException("submit-%d", submitted);
+        }
+        converter->Drain();
+        amf::AMFDataPtr data;
+        const uint64_t deadline = VROSTBridgeNowUs() + 500000;
+        while (!data && VROSTBridgeNowUs() < deadline) {
+            const AMF_RESULT result = converter->QueryOutput(&data);
+            if (data || result == AMF_EOF) break;
+            amf_sleep(1);
+        }
+        if (!data) throw MakeException("no-output");
+        amf::AMFSurfacePtr output(data);
+        if (!output || output->GetFormat() != outputFormat) throw MakeException("output-format");
+        if (output->Convert(amf::AMF_MEMORY_HOST) != AMF_OK) throw MakeException("download");
+        amf::AMFPlane* luma = output->GetPlane(amf::AMF_PLANE_Y);
+        amf::AMFPlane* chroma = output->GetPlane(amf::AMF_PLANE_UV);
+        if (!luma || !chroma || !luma->GetNative() || !chroma->GetNative()) {
+            throw MakeException("planes");
+        }
+        const int sampleBytes = luma->GetPixelSizeInBytes(); // 1 for NV12, 2 for P010
+        if (sampleBytes != 1 && sampleBytes != 2) throw MakeException("sample-size");
+        measured.bits = sampleBytes == 2 ? 10 : 8;
+        const auto read = [&](amf::AMFPlane* source, int x, int y, int component) {
+            const uint8_t* at = static_cast<const uint8_t*>(source->GetNative())
+                + size_t(y + source->GetOffsetY()) * size_t(source->GetHPitch())
+                + size_t(x + source->GetOffsetX()) * size_t(source->GetPixelSizeInBytes())
+                + size_t(component) * size_t(sampleBytes);
+            if (sampleBytes == 1) return int(*at);
+            uint16_t value;
+            std::memcpy(&value, at, sizeof(value));
+            return int(value >> 6); // P010 keeps the 10-bit code in the top bits
+        };
+        for (int i = 0; i < vrost_color::kColours; ++i) {
+            const int x = i * kStripe + kStripe / 2, y = kHeight / 2;
+            measured.code[i][0] = read(luma, x, y, 0);
+            measured.code[i][1] = read(chroma, x / 2, y / 2, 0);
+            measured.code[i][2] = read(chroma, x / 2, y / 2, 1);
+        }
+        converter->Terminate();
+        return true;
+    } catch (const std::exception& error) {
+        why = error.what();
+        if (converter) converter->Terminate();
+        return false;
+    }
+}
+
+bool VideoEncoderAMF::AddYuvConverter(
+    amf::AMF_SURFACE_FORMAT outputFormat, const char* path, std::string& why
+) {
+    // Convert to the colour space the encoder would write for RGB input (MakeEncoder).
+    const int64_t wanted = m_color.profile;
+    vrost_color::Measured measured;
+    if (!ProbeConverter(outputFormat, wanted, measured, why)) return false;
+    m_colorMeasured = measured;
+    m_colorProbed = true;
+    const vrost_color::Verdict verdict = vrost_color::Classify(measured);
+    if (!verdict.known || !verdict.displayable) {
+        why = verdict.reason;
+        return false;
+    }
+    try {
+        m_amfComponents.emplace_back(
+            MakeConverter(m_surfaceFormat, m_renderWidth, m_renderHeight, outputFormat, wanted)
+        );
+    } catch (const std::exception& error) {
+        why = error.what();
+        return false;
+    }
+    // Label the stream with what the samples really are. When the converter ignored the
+    // requested range (or matrix), the decoder still reconstructs the picture exactly.
+    m_color.profile = verdict.profile;
+    m_color.full = verdict.full;
+    m_color.yuvInput = true;
+    m_color.verified = true;
+    if (verdict.profile != wanted) {
+        Warn(
+            "VROST_COLOR_RELABEL path=%s requested_profile=%lld produced_profile=%lld",
+            path,
+            (long long)wanted,
+            (long long)verdict.profile
+        );
+    }
+    return true;
+}
+
+void VideoEncoderAMF::LogColorSetup(
+    const char* path, const vrost_color::Measured* measured, const std::string& refused
+) {
+    // One structured line per encoder start; the host companion keeps it for reports.
+    std::string reason = refused.empty() ? std::string("none") : refused;
+    for (char& c : reason) {
+        if (!isalnum(static_cast<unsigned char>(c)) && c != ':' && c != '-' && c != '.' && c != '_' && c != '+')
+            c = '-';
+    }
+    if (reason.size() > 48) reason.resize(48);
+    const bool hdr = Settings_Instance()->m_enableHdr;
+    const int matrix = hdr ? 2020 : vrost_color::MatrixOfProfile(m_color.profile);
+    char codes[160] = "";
+    if (measured) {
+        const auto& c = measured->code;
+        snprintf(
+            codes,
+            sizeof(codes),
+            " probe_bits=%d black=%d,%d,%d white=%d,%d,%d red=%d,%d,%d grey=%d,%d,%d",
+            measured->bits,
+            c[0][0], c[0][1], c[0][2], c[1][0], c[1][1], c[1][2],
+            c[2][0], c[2][1], c[2][2], c[3][0], c[3][1], c[3][2]
+        );
+    }
+    Info(
+        "VROST_COLOR path=%s bits=%d range=%s matrix=%d verified=%d refused=%s%s",
+        path,
+        m_use10bit ? 10 : 8,
+        hdr || m_color.full ? "full" : "studio",
+        matrix,
+        m_color.verified ? 1 : 0,
+        reason.c_str(),
+        codes
+    );
+}
