diff --git a/alvr/server_openvr/src/vrostbridge_pose.rs b/alvr/server_openvr/src/vrostbridge_pose.rs
new file mode 100644
index 00000000..c4bf7f4e
--- /dev/null
+++ b/alvr/server_openvr/src/vrostbridge_pose.rs
@@ -0,0 +1,105 @@
+//! VROSTBridge (patch 0018): encoded frames that had no head pose to go with them.
+//!
+//! The host sends a frame only together with the head pose it was rendered for, and that
+//! pose arrives in the client's tracking. The client sends tracking only while its own
+//! SteamVR tracks the headset (base stations seen, headset awake). So when frames keep
+//! being dropped here for lack of a pose, the video is fine and the network is fine: the
+//! headset is not tracked on the headset PC. Until 1.0.0.5 this was silent and looked
+//! like "video not arriving".
+//!
+//! Counts are encoder outputs (one per frame, occasionally more), totalled per window and
+//! logged only for windows that dropped any.
+
+use std::time::{Duration, Instant};
+
+pub const WINDOW: Duration = Duration::from_secs(5);
+
+#[derive(Default)]
+pub struct PoselessFrames {
+    dropped: u64,
+    sent: u64,
+    window_start: Option<Instant>,
+}
+
+impl PoselessFrames {
+    pub const fn new() -> Self {
+        Self {
+            dropped: 0,
+            sent: 0,
+            window_start: None,
+        }
+    }
+
+    /// Counts one encoded output (sent with its pose, or dropped without one). At the end
+    /// of each window returns (dropped, sent) for it when any were dropped.
+    pub fn note(&mut self, sent: bool, now: Instant) -> Option<(u64, u64)> {
+        if sent {
+            self.sent += 1;
+        } else {
+            self.dropped += 1;
+        }
+        let start = *self.window_start.get_or_insert(now);
+        if now.saturating_duration_since(start) < WINDOW {
+            return None;
+        }
+        let counts = (self.dropped, self.sent);
+        *self = Self {
+            dropped: 0,
+            sent: 0,
+            window_start: Some(now),
+        };
+        (counts.0 > 0).then_some(counts)
+    }
+
+    /// A new session starts counting afresh.
+    pub fn reset(&mut self) {
+        *self = Self::new();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_window_without_drops_logs_nothing_and_one_with_drops_reports_both_counts() {
+        let start = Instant::now();
+        let mut frames = PoselessFrames::new();
+        for i in 0..375 {
+            assert_eq!(frames.note(true, start + Duration::from_millis(i * 13)), None);
+        }
+        // The window closes on the next output: nothing was dropped, nothing to say.
+        assert_eq!(frames.note(true, start + Duration::from_millis(5000)), None);
+        let second = start + Duration::from_millis(5000);
+        for i in 1..=10 {
+            assert_eq!(frames.note(false, second + Duration::from_millis(i * 13)), None);
+        }
+        for i in 11..300 {
+            assert_eq!(frames.note(true, second + Duration::from_millis(i * 13)), None);
+        }
+        assert_eq!(frames.note(false, second + WINDOW), Some((11, 289)));
+    }
+
+    #[test]
+    fn an_untracked_headset_drops_every_frame_and_a_reset_starts_afresh() {
+        let start = Instant::now();
+        let mut frames = PoselessFrames::new();
+        // 75 frames a second, none with a pose: the first report comes after five seconds.
+        let mut outputs = 0u64;
+        let reported = loop {
+            let at = start + Duration::from_micros(outputs * 13_333);
+            outputs += 1;
+            if let Some(counts) = frames.note(false, at) {
+                break (counts, at);
+            }
+        };
+        assert_eq!(reported.0, (outputs, 0));
+        assert!(reported.1 - start >= WINDOW && reported.1 - start < WINDOW + Duration::from_millis(20));
+        frames.note(false, start + Duration::from_secs(6));
+        frames.reset();
+        // Counting restarts with the next output, so a new session's window starts then.
+        assert_eq!(frames.note(true, start + Duration::from_secs(60)), None);
+        assert_eq!(frames.note(false, start + Duration::from_secs(64)), None);
+        assert_eq!(frames.note(true, start + Duration::from_secs(65)), Some((1, 2)));
+    }
+}
