+
+    #[test]
+    fn a_pause_in_the_gaze_holds_the_region_then_returns_it() {
+        // Patch 0017: a blink or an eye-tracker pause keeps the region where the user looked.
+        let views = [view(0.0), view(0.0)];
+        let defaults = [[0.0, 0.0], [0.0, 0.0]];
+        let start = Instant::now();
+        let looked = Quat::from_rotation_y((-20f32).to_radians());
+        let mut state = DynamicFoveation::default();
+        let mut input = FrameInput {
+            gaze: Some((looked, start)),
+            views: &views,
+            geometry: geometry(),
+            defaults,
+            deadband: 0.025,
+            stale: Duration::from_millis(150),
+            hold: Duration::from_millis(1000),
+            now: start,
+            optical_centre: false,
+        };
+        let following = state.update(&input);
+        assert_ne!(following, defaults);
+        // 400 ms without a new sample (stale after 150 ms): the region stays where it was.
+        input.now = start + Duration::from_millis(400);
+        assert_eq!(state.update(&input), following);
+        input.now = start + Duration::from_millis(1100);
+        assert_eq!(state.update(&input), following);
+        assert_eq!(state.held_frames, 2);
+        assert_eq!(state.fallback_frames, 0);
+        // Fresh gaze again ends the pause (one pause, measured from its first stale frame).
+        input.gaze = Some((looked, start + Duration::from_millis(1200)));
+        input.now = start + Duration::from_millis(1200);
+        assert_eq!(state.update(&input), following);
+        assert_eq!((state.pauses, state.longest_pause_ms), (1, 800));
+        // A pause longer than stale + hold returns the region to the fixed centre, once.
+        input.now = start + Duration::from_millis(1200 + 1151);
+        assert_eq!(state.update(&input), defaults);
+        input.now = start + Duration::from_millis(1200 + 1300);
+        assert_eq!(state.update(&input), defaults);
+        assert_eq!((state.returns, state.fallback_frames), (1, 2));
+        // The next fresh gaze moves the region again (a move from the fixed centre).
+        let moves = state.moves;
+        input.gaze = Some((looked, input.now));
+        assert_eq!(state.update(&input), following);
+        assert_eq!(state.moves, moves + 1);
+        // Without hold the region returns as soon as the gaze is stale (the 1.0.0.3 behaviour).
+        let mut old = DynamicFoveation::default();
+        input.hold = Duration::ZERO;
+        input.gaze = Some((looked, start));
+        input.now = start;
+        assert_eq!(old.update(&input), following);
+        input.now = start + Duration::from_millis(151);
+        assert_eq!(old.update(&input), defaults);
+        // No gaze at all this connection: the fixed centre, and no pause is counted.
+        let mut never = DynamicFoveation::default();
+        input.gaze = None;
+        assert_eq!(never.update(&input), defaults);
+        assert_eq!((never.pauses, never.held_frames, never.returns), (0, 0, 0));
+    }
