diff --git a/alvr/client_core/src/vrostbridge_stream.rs b/alvr/client_core/src/vrostbridge_stream.rs
new file mode 100644
index 00000000..37ea789e
--- /dev/null
+++ b/alvr/client_core/src/vrostbridge_stream.rs
@@ -0,0 +1,124 @@
+//! VROSTBridge: client-side video stream counters and the loss-recovery policy.
+//!
+//! The pinned client core reacts to every lost video packet by asking the host for
+//! a keyframe, but the embedding application could not see how often that happened.
+//! These counters make network loss visible in the session quality line, so a
+//! freeze can be told apart from a slow decoder or a late host.
+//!
+//! The policy decides whether a loss asks for a keyframe. Keyframe recovery (the
+//! default) is unchanged from upstream. Gradual recovery is for hosts that refresh
+//! the picture with periodic intra-coded stripes: one isolated loss then heals by
+//! itself within the refresh period, so requesting a large keyframe would only add
+//! a burst to an already struggling link. A keyframe is still requested when losses
+//! repeat in consecutive frames, so a host that cannot refresh never leaves the
+//! picture broken.
+
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+/// Losses in consecutive frames after which gradual recovery still asks for a keyframe.
+pub const GRADUAL_KEYFRAME_AFTER: u64 = 3;
+
+#[derive(Default)]
+pub struct StreamCounters {
+    pub frames: AtomicU64,
+    pub network_losses: AtomicU64,
+    pub idr_requests: AtomicU64,
+    pub decoder_saturation: AtomicU64,
+    pub skipped_until_idr: AtomicU64,
+}
+
+#[derive(Clone, Copy, Default, Debug, PartialEq, Eq)]
+pub struct StreamCounterSnapshot {
+    pub frames: u64,
+    pub network_losses: u64,
+    pub idr_requests: u64,
+    pub decoder_saturation: u64,
+    pub skipped_until_idr: u64,
+}
+
+impl StreamCounters {
+    pub fn snapshot(&self) -> StreamCounterSnapshot {
+        StreamCounterSnapshot {
+            frames: self.frames.load(Ordering::Relaxed),
+            network_losses: self.network_losses.load(Ordering::Relaxed),
+            idr_requests: self.idr_requests.load(Ordering::Relaxed),
+            decoder_saturation: self.decoder_saturation.load(Ordering::Relaxed),
+            skipped_until_idr: self.skipped_until_idr.load(Ordering::Relaxed),
+        }
+    }
+
+    pub fn add(counter: &AtomicU64) {
+        counter.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+#[derive(Default)]
+pub struct LossPolicy {
+    gradual: AtomicBool,
+    consecutive: AtomicU64,
+}
+
+impl LossPolicy {
+    pub fn set_gradual(&self, enabled: bool) {
+        self.gradual.store(enabled, Ordering::Relaxed);
+        self.consecutive.store(0, Ordering::Relaxed);
+    }
+
+    pub fn gradual(&self) -> bool {
+        self.gradual.load(Ordering::Relaxed)
+    }
+
+    /// A frame arrived with missing packets. Returns true when a keyframe should be requested.
+    pub fn on_loss(&self) -> bool {
+        let consecutive = self.consecutive.fetch_add(1, Ordering::Relaxed) + 1;
+        !self.gradual() || consecutive >= GRADUAL_KEYFRAME_AFTER
+    }
+
+    /// A complete frame arrived, or a keyframe restarted the stream.
+    pub fn on_clean_frame(&self) {
+        self.consecutive.store(0, Ordering::Relaxed);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn keyframe_policy_requests_on_every_loss() {
+        let policy = LossPolicy::default();
+        assert!(policy.on_loss());
+        assert!(policy.on_loss());
+        policy.on_clean_frame();
+        assert!(policy.on_loss());
+    }
+
+    #[test]
+    fn gradual_policy_requests_only_for_repeated_losses() {
+        let policy = LossPolicy::default();
+        policy.set_gradual(true);
+        assert!(!policy.on_loss());
+        policy.on_clean_frame();
+        assert!(!policy.on_loss());
+        assert!(!policy.on_loss());
+        assert!(policy.on_loss(), "third consecutive loss asks for a keyframe");
+        policy.on_clean_frame();
+        assert!(!policy.on_loss());
+        policy.set_gradual(false);
+        assert!(policy.on_loss());
+    }
+
+    #[test]
+    fn counters_snapshot() {
+        let counters = StreamCounters::default();
+        StreamCounters::add(&counters.frames);
+        StreamCounters::add(&counters.frames);
+        StreamCounters::add(&counters.network_losses);
+        StreamCounters::add(&counters.idr_requests);
+        let snapshot = counters.snapshot();
+        assert_eq!(snapshot.frames, 2);
+        assert_eq!(snapshot.network_losses, 1);
+        assert_eq!(snapshot.idr_requests, 1);
+        assert_eq!(snapshot.decoder_saturation, 0);
+    }
+}
