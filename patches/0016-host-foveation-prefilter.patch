diff --git a/alvr/server_openvr/cpp/platform/win32/FFR.cpp b/alvr/server_openvr/cpp/platform/win32/FFR.cpp
index a3b3dbcb..aa91c617 100644
--- a/alvr/server_openvr/cpp/platform/win32/FFR.cpp
+++ b/alvr/server_openvr/cpp/platform/win32/FFR.cpp
@@ -94,6 +94,23 @@ void FFR::Initialize(ID3D11Texture2D* compositionTexture) {
         );
 
         mPipelines.push_back(compressAxisAlignedPipeline);
+
+        // VROSTBridge (patch 0016): the compression pass samples its input (which has a mip
+        // chain, see FrameRender::Startup) anisotropically and clamped to the picture. Until
+        // now it used whatever sampler the layer pass left bound (anisotropic but wrapping, on
+        // a texture without mips: no filtering across the reduced edges' footprint).
+        D3D11_SAMPLER_DESC sampler = {};
+        sampler.Filter = D3D11_FILTER_ANISOTROPIC;
+        sampler.AddressU = D3D11_TEXTURE_ADDRESS_CLAMP;
+        sampler.AddressV = D3D11_TEXTURE_ADDRESS_CLAMP;
+        sampler.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+        sampler.MaxAnisotropy = D3D11_REQ_MAXANISOTROPY;
+        sampler.ComparisonFunc = D3D11_COMPARISON_NEVER;
+        sampler.MinLOD = 0;
+        sampler.MaxLOD = D3D11_FLOAT32_MAX;
+        if (FAILED(mDevice->CreateSamplerState(&sampler, &mCompressSampler))) {
+            mCompressSampler.Reset();
+        }
     } else {
         mOptimizedTexture = compositionTexture;
     }
@@ -128,9 +145,20 @@ void FFR::Render(uint64_t targetTimestampNs) {
         fovVars.centerShiftRightY
     );
 
+    // VROSTBridge (patch 0016): the compression pass's own sampler; the one bound before is
+    // put back for the passes after it.
+    ComPtr<ID3D11SamplerState> previousSampler;
+    if (mCompressSampler) {
+        mImmediateContext->PSGetSamplers(0, 1, previousSampler.ReleaseAndGetAddressOf());
+        mImmediateContext->PSSetSamplers(0, 1, mCompressSampler.GetAddressOf());
+    }
     for (auto& p : mPipelines) {
         p.Render();
     }
+    if (mCompressSampler) {
+        ID3D11SamplerState* restore = previousSampler.Get();
+        mImmediateContext->PSSetSamplers(0, 1, &restore);
+    }
 }
 
 ID3D11Texture2D* FFR::GetOutputTexture() { return mOptimizedTexture.Get(); }
