@@ -115,14 +115,41 @@ bool FrameRender::Startup() {
     compositionTextureDesc.Usage = D3D11_USAGE_DEFAULT;
     compositionTextureDesc.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
 
+    // VROSTBridge (patch 0016): with foveated encoding the composition gets a full mip chain,
+    // regenerated each frame, so the compression pass filters the reduced edges over the
+    // area each encoded pixel covers (mip-mapped, anisotropic) instead of picking one bilinear
+    // sample from up to five source pixels: that aliasing made the periphery shimmer. With
+    // colour correction on, that pass's output carries the mip chain instead.
+    m_compositionMips = Settings_Instance()->m_enableFoveatedEncoding
+        && !Settings_Instance()->m_enableColorCorrection;
+    if (m_compositionMips) {
+        compositionTextureDesc.MipLevels = 0;
+        compositionTextureDesc.MiscFlags = D3D11_RESOURCE_MISC_GENERATE_MIPS;
+    }
+
     ComPtr<ID3D11Texture2D> compositionTexture;
 
     if (FAILED(m_pD3DRender->GetDevice()->CreateTexture2D(
             &compositionTextureDesc, NULL, &compositionTexture
         ))) {
-        Error("Failed to create staging texture!\n");
-        return false;
+        // Without a mip chain the compression pass samples as upstream ALVR does.
+        compositionTextureDesc.MipLevels = 1;
+        compositionTextureDesc.MiscFlags = 0;
+        m_compositionMips = false;
+        if (FAILED(m_pD3DRender->GetDevice()->CreateTexture2D(
+                &compositionTextureDesc, NULL, &compositionTexture
+            ))) {
+            Error("Failed to create staging texture!\n");
+            return false;
+        }
     }
+    if (m_compositionMips
+        && FAILED(m_pD3DRender->GetDevice()->CreateShaderResourceView(
+            compositionTexture.Get(), NULL, &m_compositionResourceView
+        ))) {
+        m_compositionMips = false;
+    }
+    Info("VROST_FOVEATION_PREFILTER composition_mips=%d", m_compositionMips ? 1 : 0);
 
     HRESULT hr = m_pD3DRender->GetDevice()->CreateRenderTargetView(
         compositionTexture.Get(), NULL, &m_pRenderTargetView
@@ -398,12 +425,15 @@ bool FrameRender::Startup() {
             COLOR_CORRECTION_CSO_PTR, COLOR_CORRECTION_CSO_PTR + COLOR_CORRECTION_CSO_LEN
         );
 
+        // VROSTBridge (patch 0016): the compression pass reads this one; its pipeline regenerates
+        // the mip chain after each pass.
         ComPtr<ID3D11Texture2D> colorCorrectedTexture = CreateTexture(
             m_pD3DRender->GetDevice(),
             Settings_Instance()->m_renderWidth,
             Settings_Instance()->m_renderHeight,
             Settings_Instance()->m_enableHdr ? DXGI_FORMAT_R16G16B16A16_FLOAT
-                                             : DXGI_FORMAT_R8G8B8A8_UNORM_SRGB
+                                             : DXGI_FORMAT_R8G8B8A8_UNORM_SRGB,
+            Settings_Instance()->m_enableFoveatedEncoding
         );
 
         struct ColorCorrection {
@@ -865,6 +895,11 @@ bool FrameRender::RenderFrame(
     m_pD3DRender->GetContext()->RSSetViewports(1, &m_viewport);
     m_pD3DRender->GetContext()->RSSetScissorRects(1, &m_scissor);
 
+    if (m_compositionMips) {
+        // VROSTBridge (patch 0016): the mip chain of this frame's composition.
