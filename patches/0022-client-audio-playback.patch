+#[cfg(not(target_os = "android"))]
+pub use device::play_game_audio_loop;
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const RATE: u32 = 48_000;
+
+    fn sine(freq: f64, rate: u32, start: usize, frames: usize) -> Vec<f32> {
+        (start..start + frames)
+            .flat_map(|i| {
+                let v = (2.0 * std::f64::consts::PI * freq * i as f64 / f64::from(rate)).sin() as f32 * 0.5;
+                [v, v]
+            })
+            .collect()
+    }
+
+    /// Simulates `seconds` of a host sending 10 ms packets (`arrival_delay_ms` gives each packet's
+    /// arrival delay, None for a packet never sent) and a device pulling 10 ms periods at
+    /// `device_rate` × `device_speed`. Returns the output and the correction at every period.
+    fn run_with_corrections(
+        player: &mut JitterPlayer,
+        seconds: f64,
+        device_rate: u32,
+        device_speed: f64,
+        arrival_delay_ms: impl Fn(usize) -> Option<f64>,
+    ) -> (Vec<f32>, Vec<f64>) {
+        let start = Instant::now();
+        let packet = (RATE / 100) as usize;
+        let period = (device_rate / 100) as usize;
+        let mut events: Vec<(f64, bool, usize)> = vec![]; // (time ms, is_packet, index)
+        let packets = (seconds * 100.0) as usize;
+        for i in 0..packets {
+            if let Some(delay) = arrival_delay_ms(i) {
+                events.push((i as f64 * 10.0 + delay, true, i));
+            }
+        }
+        let periods = (seconds * 100.0 * device_speed) as usize;
+        for j in 0..periods {
+            events.push((j as f64 * 10.0 / device_speed, false, j));
+        }
+        events.sort_by(|a, b| a.0.partial_cmp(&b.0).unwrap().then(b.1.cmp(&a.1)));
+        let (mut out, mut corrections) = (vec![], vec![]);
+        let mut last_index = None;
+        for (time, is_packet, index) in events {
+            let now = start + Duration::from_secs_f64(time / 1000.0);
+            if is_packet {
+                let lost = last_index.is_some_and(|last: usize| index > last + 1);
+                last_index = Some(index);
+                player.push(&sine(440.0, RATE, index * packet, packet), lost, now);
+            } else {
+                let mut buffer = vec![0.0; period * 2];
+                player.fill(&mut buffer, 2, now);
+                out.extend(buffer);
+                corrections.push(player.correction());
+            }
+        }
+        (out, corrections)
+    }
+
+    fn run(
+        player: &mut JitterPlayer,
+        seconds: f64,
+        device_rate: u32,
+        device_speed: f64,
+        arrival_delay_ms: impl Fn(usize) -> Option<f64>,
+    ) -> Vec<f32> {
+        run_with_corrections(player, seconds, device_rate, device_speed, arrival_delay_ms).0
+    }
+
+    #[test]
+    fn drifting_clocks_settle_at_the_target_without_dropouts() {
+        // 0.3 % is far more than two real sound clocks differ by (usually below 0.01 %).
+        for speed in [0.997, 1.0, 1.003] {
+            let mut player = JitterPlayer::new(RATE, RATE, 50);
+            let (_, corrections) = run_with_corrections(&mut player, 150.0, RATE, speed, |_| Some(1.0));
+            let s = player.stats;
+            assert_eq!((s.underruns, s.trims, s.losses), (0, 0, 0), "speed {speed}");
+            // The buffer stays near its target: a slower device leaves a little more queued.
+            assert!((player.buffered_ms() - 50.0).abs() < 15.0, "speed {speed}: {}", player.buffered_ms());
+            // Over the last 30 s the playback speed matched the device's exactly, on average.
+            let last = &corrections[corrections.len() - 3000..];
+            let average = last.iter().sum::<f64>() / last.len() as f64;
+            assert!((average - (1.0 / speed - 1.0)).abs() < 0.0002, "speed {speed}: {average}");
+        }
+    }
+
+    #[test]
+    fn bursty_arrival_within_the_target_plays_smoothly() {
+        let mut player = JitterPlayer::new(RATE, RATE, 50);
+        // Packets arrive in bursts of four, up to 30 ms late.
+        run(&mut player, 30.0, RATE, 1.0, |i| Some(30.0 - (i % 4) as f64 * 10.0));
+        assert_eq!(player.stats.underruns, 0);
+        assert_eq!(player.stats.trims, 0);
+    }
+
+    #[test]
+    fn a_stall_counts_as_an_underrun_and_raises_the_target_and_a_pause_does_not() {
+        let mut player = JitterPlayer::new(RATE, RATE, 50);
+        // Packets 500..510 arrive 110 ms late: the buffer runs dry once.
+        run(&mut player, 10.0, RATE, 1.0, |i| Some(if (500..510).contains(&i) { 110.0 } else { 1.0 }));
+        assert_eq!(player.stats.underruns, 1);
+        assert_eq!(player.stats.pauses, 0);
+        assert_eq!(player.target_ms(), 60.0);
+
+        let mut player = JitterPlayer::new(RATE, RATE, 50);
+        // The host sends nothing for a second (its sound stopped): a pause, the target stays.
+        run(&mut player, 10.0, RATE, 1.0, |i| (!(300..400).contains(&i)).then_some(1.0));
+        assert_eq!(player.stats.underruns, 0);
+        assert_eq!(player.stats.pauses, 1);
+        assert_eq!(player.target_ms(), 50.0);
+    }
+
+    #[test]
+    fn a_lost_packet_is_bridged_without_emptying_the_buffer() {
+        let mut player = JitterPlayer::new(RATE, RATE, 50);
+        let out = run(&mut player, 10.0, RATE, 1.0, |i| (i != 400).then_some(1.0));
+        assert_eq!(player.stats.losses, 1);
+        assert_eq!(player.stats.underruns, 0);
+        // No sample jumps more than a 440 Hz sine at half scale ever does, apart from the bridge.
+        let max_step = out.chunks_exact(2).collect::<Vec<_>>().windows(2)
+            .map(|w| (w[1][0] - w[0][0]).abs()).fold(0.0f32, f32::max);
+        assert!(max_step < 0.2, "{max_step}");
+    }
+
+    #[test]
+    fn a_long_burst_is_trimmed_back_to_the_target() {
+        let mut player = JitterPlayer::new(RATE, RATE, 50);
+        // Everything from 3 s to 3.5 s arrives at 3.5 s together with what follows.
+        run(&mut player, 10.0, RATE, 1.0, |i| Some(if (300..350).contains(&i) { 500.0 - (i - 300) as f64 * 10.0 } else { 1.0 }));
+        assert!(player.stats.trims <= 1);
+        assert!((player.buffered_ms() - 50.0).abs() < 15.0, "{}", player.buffered_ms());
+    }
+
+    fn rms(signal: &[f32]) -> f64 {
+        (signal.iter().map(|v| f64::from(*v) * f64::from(*v)).sum::<f64>() / signal.len() as f64).sqrt()
+    }
+
+    /// RMS of the settled output for a sine of `freq` at half scale (0.354 when it passes).
+    fn converted_rms(freq: f64, out_rate: u32) -> f64 {
+        let mut player = JitterPlayer::new(RATE, out_rate, 50);
+        let start = Instant::now();
+        let period = (out_rate / 100) as usize;
+        let mut out = vec![];
+        for i in 0..300 {
+            let now = start + Duration::from_millis(i * 10);
+            player.push(&sine(freq, RATE, i as usize * 480, 480), false, now);
+            let mut buffer = vec![0.0; period * 2];
+            player.fill(&mut buffer, 2, now);
+            out.extend(buffer);
+        }
+        rms(&out[out.len() / 2..])
+    }
+
+    #[test]
+    fn rate_conversion_keeps_tones_and_removes_what_would_alias() {
+        let full = 0.5 / 2f64.sqrt();
+        // 48 kHz in, 44.1 kHz out (what PipeWire's ALSA plugin defaulted to): a 1 kHz tone keeps
+        // its level. A 23 kHz tone cannot exist at 44.1 kHz; dropping samples, as the pinned
+        // playback did, folds it back to an audible 21.1 kHz at full level. Here it is filtered.
+        assert!((converted_rms(1000.0, 44_100) / full - 1.0).abs() < 0.02);
+        assert!((converted_rms(15000.0, 44_100) / full - 1.0).abs() < 0.05);
+        assert!(converted_rms(23000.0, 44_100) / full < 0.1, "{}", converted_rms(23000.0, 44_100) / full);
+        // Same rate: the whole audible band passes.
+        assert!((converted_rms(1000.0, RATE) / full - 1.0).abs() < 0.02);
+        assert!(converted_rms(18000.0, RATE) / full > 0.9, "{}", converted_rms(18000.0, RATE) / full);
+    }
+
+    #[test]
+    fn mono_and_multichannel_outputs() {
+        let mut player = JitterPlayer::new(RATE, RATE, 20);
+        let now = Instant::now();
+        let stereo: Vec<f32> = (0..4800).flat_map(|_| [0.5f32, -0.5]).collect();
+        player.push(&stereo, false, now);
+        let mut mono = vec![1.0; 480];
+        player.fill(&mut mono, 1, now);
+        assert!(mono.iter().all(|v| v.abs() < 1e-3));
+        // Left and right on the first two channels, silence on the rest (after the fade-in).
+        let mut six = vec![1.0; 480 * 6];
+        player.fill(&mut six, 6, now);
+        assert!(six.chunks_exact(6).all(|f| (f[0] - 0.5).abs() < 0.01 && (f[1] + 0.5).abs() < 0.01 && f[2..].iter().all(|v| *v == 0.0)));
+    }
+}
