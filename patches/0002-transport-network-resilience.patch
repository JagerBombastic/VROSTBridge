@@ -0,0 +1,31 @@
+//! A delayed control heartbeat alone must not discard healthy live media.
+//! Grace is bounded, requires recent complete frames/statistics, and never
+//! applies to EOF, explicit Stop/Restart, socket errors or lifecycle pause.
+use std::time::{Duration, Instant};
+const MEDIA_FRESH: Duration = Duration::from_millis(500);
+const MAX_CONTROL_SILENCE: Duration = Duration::from_secs(6);
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum HeartbeatDecision { Healthy, MediaGrace, Disconnect }
+
+pub fn heartbeat_decision(now: Instant, last_control: Instant, last_media: Option<Instant>) -> HeartbeatDecision {
+    let silence = now.saturating_duration_since(last_control);
+    if silence <= crate::KEEPALIVE_TIMEOUT { return HeartbeatDecision::Healthy; }
+    if silence < MAX_CONTROL_SILENCE && last_media.is_some_and(|media| now.saturating_duration_since(media) <= MEDIA_FRESH) {
+        HeartbeatDecision::MediaGrace
+    } else { HeartbeatDecision::Disconnect }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn grace_requires_recent_media_and_has_a_hard_ceiling() {
+        let start=Instant::now();
+        assert_eq!(heartbeat_decision(start+Duration::from_secs(1),start,None),HeartbeatDecision::Healthy);
+        assert_eq!(heartbeat_decision(start+Duration::from_secs(3),start,None),HeartbeatDecision::Disconnect);
+        assert_eq!(heartbeat_decision(start+Duration::from_secs(3),start,Some(start+Duration::from_millis(2900))),HeartbeatDecision::MediaGrace);
+        assert_eq!(heartbeat_decision(start+Duration::from_secs(3),start,Some(start+Duration::from_secs(2))),HeartbeatDecision::Disconnect);
+        assert_eq!(heartbeat_decision(start+Duration::from_secs(6),start,Some(start+Duration::from_secs(6))),HeartbeatDecision::Disconnect);
+    }
+}
