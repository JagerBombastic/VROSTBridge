+#[cfg(test)]
+mod vrostbridge_tests {
+    use super::*;
+    use std::time::{Duration, Instant};
+
+    #[test]
+    fn announcer_drop_releases_daemon_without_waiting_on_it() {
+        let announcer = AnnouncerSocket::new("vrostbridge-test.client.local.").unwrap();
+        let observer = announcer.daemon.clone();
+        let started = Instant::now();
+        drop(announcer);
+        assert!(started.elapsed() < Duration::from_millis(250));
+        let deadline = Instant::now() + Duration::from_secs(2);
+        while Instant::now() < deadline {
+            if let Ok(reply) = observer.status() {
+                if matches!(reply.recv_timeout(Duration::from_millis(50)), Ok(mdns_sd::DaemonStatus::Shutdown)) {
+                    return;
+                }
+            }
+            std::thread::sleep(Duration::from_millis(10));
+        }
+        panic!("announcer's mDNS daemon remained alive after its owner was dropped");
+    }
+}
