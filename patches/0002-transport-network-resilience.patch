+#[cfg(test)]
+mod vrostbridge_control_tests {
+    use super::*;
+
+    fn pair() -> (TcpStream, TcpStream) {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let writer = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        (writer, listener.accept().unwrap().0)
+    }
+
+    #[test]
+    fn eof_is_a_terminal_error_without_waiting_for_heartbeat() {
+        let (writer, mut reader) = pair();
+        drop(writer);
+        reader.set_read_timeout(Some(Duration::from_secs(1))).unwrap();
+        let start = Instant::now();
+        let result = framed_recv::<u32>(&mut reader, &mut vec![], &mut None, Duration::from_secs(1));
+        assert!(matches!(result, Err(alvr_common::ConnectionError::Other(_))));
+        assert!(start.elapsed() < Duration::from_millis(200));
+    }
+
+    #[test]
+    fn partial_prefix_is_preserved_across_read_deadlines() {
+        let (mut writer, mut reader) = pair();
+        reader.set_read_timeout(Some(Duration::from_millis(20))).unwrap();
+        let packet = bincode::serde::encode_to_vec(1000_u32, config::standard()).unwrap();
+        let prefix = (packet.len() as u32).to_le_bytes();
+        writer.write_all(&prefix[..2]).unwrap();
+        let (mut buffer, mut cursor) = (vec![], None);
+        let result = framed_recv::<u32>(&mut reader, &mut buffer, &mut cursor, Duration::from_millis(25));
+        assert!(matches!(result, Err(alvr_common::ConnectionError::TryAgain(_))));
+        writer.write_all(&prefix[2..]).unwrap();
+        writer.write_all(&packet).unwrap();
+        assert_eq!(framed_recv::<u32>(&mut reader, &mut buffer, &mut cursor, Duration::from_secs(1)).ok().unwrap(), 1000);
+    }
+
+    #[test]
+    fn eof_after_a_partial_prefix_is_terminal_too() {
+        let (mut writer, mut reader) = pair();
+        writer.write_all(&[20, 0]).unwrap();
+        drop(writer);
+        reader.set_read_timeout(Some(Duration::from_secs(1))).unwrap();
+        let start = Instant::now();
+        let result = framed_recv::<u32>(&mut reader, &mut vec![], &mut None, Duration::from_secs(1));
+        assert!(matches!(result, Err(alvr_common::ConnectionError::Other(_))));
+        assert!(start.elapsed() < Duration::from_millis(200));
+    }
