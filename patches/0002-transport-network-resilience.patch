+impl Drop for AnnouncerSocket {
+    fn drop(&mut self) {
+        // ServiceDaemon is only a clonable handle; dropping it does not stop
+        // its worker. Each reconnect must release its advertisements and thread.
+        let fullname = format!("{}.{}", self.instance, alvr_sockets::MDNS_SERVICE_TYPE);
+        self.daemon.unregister(&fullname).ok();
+        self.daemon.shutdown().ok();
+    }
+}
