 pub const LOCAL_IP: IpAddr = IpAddr::V4(Ipv4Addr::UNSPECIFIED);
+/// Optional per-process source selected by the VROSTBridge companion. Invalid
+/// requests fail closed instead of silently returning to a different adapter.
+pub fn local_bind_ip() -> Result<IpAddr> {
+    match std::env::var("VROSTBRIDGE_BIND_IP") {
+        Ok(value) => {
+            let ip: Ipv4Addr = value.parse()?;
+            if !ip.is_private() || ip.is_unspecified() || ip.is_multicast() {
+                alvr_common::anyhow::bail!("VROSTBRIDGE_BIND_IP must be an assigned private IPv4 address");
+            }
+            Ok(IpAddr::V4(ip))
+        }
+        Err(std::env::VarError::NotPresent) => Ok(LOCAL_IP),
+        Err(error) => Err(error.into()),
+    }
+}
+
+/// IP_UNICAST_IF selects outgoing IPv4 packets without CAP_NET_RAW or
+/// changing host routing tables. Source-address binding alone is insufficient
+/// on Linux when two adapters occupy the same subnet (weak-host routing).
+pub fn configure_client_interface(socket: &socket2::Socket) -> Result<()> {
+    #[cfg(target_os = "linux")]
+    if let Ok(interface) = std::env::var("VROSTBRIDGE_INTERFACE") {
+        use std::{ffi::{CString, c_char, c_int, c_void}, os::fd::AsRawFd};
+        unsafe extern "C" {
+            fn if_nametoindex(name: *const c_char) -> u32;
+            fn setsockopt(fd: c_int, level: c_int, option: c_int, value: *const c_void, length: u32) -> c_int;
+        }
+        if interface.is_empty() { return Ok(()); }
+        let name = CString::new(interface.as_bytes())?;
+        let index = unsafe { if_nametoindex(name.as_ptr()) };
+        if index == 0 { return Err(std::io::Error::last_os_error().into()); }
+        let network_index = index.to_be();
+        // Linux IPPROTO_IP=0, IP_UNICAST_IF=50; option value is network order.
+        let result = unsafe { setsockopt(socket.as_raw_fd(), 0, 50, (&network_index as *const u32).cast(), 4) };
+        if result != 0 { return Err(std::io::Error::last_os_error().into()); }
+        info!("TRANSPORT selected interface={interface} ifindex={index}");
+    }
+    #[cfg(not(target_os = "linux"))]
+    let _ = socket;
+    Ok(())
+}
