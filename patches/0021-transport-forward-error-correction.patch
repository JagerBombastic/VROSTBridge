 pub struct MultiplexedUdpReader {
     inner: Socket,
     max_packet_size: usize,
     in_progress_packets: HashMap<u16, HashMap<u32, InProgressPacket>>,
+    // VROSTBridge FEC: one parity datagram at a time, and each stream's newest finished packet.
+    parity_scratch: Vec<u8>,
+    last_finished: HashMap<u16, u32>,
+}
+
+impl MultiplexedUdpReader {
+    /// VROSTBridge FEC: a parity datagram for `stream_id`'s packet `packet_index`. It is kept while
+    /// that packet is unfinished and may rebuild the one missing shard of its group. A packet
+    /// newer than the last one finished whose data shards were all lost starts from its parity
+    /// (with one shard per group, every shard can come back that way).
+    fn recv_parity(
+        &mut self,
+        stream_id: u16,
+        packet_index: u32,
+        shards_count: usize,
+        group: usize,
+        stream_queues: &HashMap<u16, StreamRecvQueues>,
+    ) -> ConResult {
+        let max_shard = self.max_packet_size - SHARD_PREFIX_SIZE;
+
+        let Some(queues) = stream_queues.get(&stream_id) else {
+            self.inner.recv(&mut []).ok();
+            return alvr_common::try_again();
+        };
+
+        self.parity_scratch
+            .resize(SHARD_PREFIX_SIZE + crate::PARITY_HEADER_SIZE + max_shard + 64, 0);
+        // Safety: u8 and MaybeUninit<u8> have the same layout, and the bytes are initialised.
+        let scratch = unsafe {
+            &mut *(ptr::from_mut(self.parity_scratch.as_mut_slice()) as *mut [MaybeUninit<u8>])
+        };
+        let size = self.inner.recv(scratch).to_con()?;
+        let header_end = SHARD_PREFIX_SIZE + crate::PARITY_HEADER_SIZE;
+        if size <= header_end {
+            return alvr_common::try_again();
+        }
+        let datagram = &self.parity_scratch[..size];
+        let payload_size =
+            u32::from_le_bytes(datagram[SHARD_PREFIX_SIZE..][..4].try_into().unwrap()) as usize;
+        let groups =
+            u32::from_le_bytes(datagram[SHARD_PREFIX_SIZE + 4..][..4].try_into().unwrap()) as usize;
+        let parity = &datagram[header_end..];
+        if payload_size == 0
+            || payload_size.div_ceil(max_shard) != shards_count
+            || groups == 0
+            || groups > shards_count
+            || group >= groups
+            || parity.len() != usize::min(max_shard, payload_size)
+        {
+            return alvr_common::try_again();
+        }
+
+        let in_progress_packets = self.in_progress_packets.entry(stream_id).or_default();
+        if !in_progress_packets.contains_key(&packet_index) {
+            // Finished already (nothing was lost) or older: nothing to do. Newer: every data
+            // shard was lost so far, so the packet starts here.
+            let newer = self.last_finished.get(&stream_id).is_none_or(|last| {
+                super::wrapping_cmp(packet_index, *last) == Ordering::Greater
+            });
+            let Some(mut buffer) = newer.then(|| queues.used_buffer_receiver.try_recv().ok()).flatten() else {
+                return alvr_common::try_again();
+            };
+            buffer.clear();
+            buffer.reserve(SHARD_PREFIX_SIZE + max_shard * shards_count);
+            in_progress_packets.insert(
+                packet_index,
+                InProgressPacket {
+                    buffer,
+                    buffer_size: 0,
+                    shards_count,
+                    received_shard_indices: HashSet::with_capacity(shards_count),
+                    fec_groups: 0,
+                    payload_size: 0,
+                    parity: HashMap::new(),
+                    recovered_shards: 0,
+                },
+            );
+        }
+        let packet = in_progress_packets.get_mut(&packet_index).unwrap();
+        if packet.shards_count != shards_count
+            || (packet.fec_groups != 0
+                && (packet.fec_groups != groups || packet.payload_size != payload_size))
+        {
+            return alvr_common::try_again();
+        }
+
+        packet.fec_groups = groups;
+        packet.payload_size = payload_size;
+        packet.parity.entry(group).or_insert_with(|| parity.to_vec());
+        packet.recover(group, max_shard);
+        let last_finished = self.last_finished.entry(stream_id).or_insert(packet_index.wrapping_sub(1));
+        finish_if_complete(in_progress_packets, packet_index, queues, stream_id, last_finished);
+
+        Ok(())
+    }
