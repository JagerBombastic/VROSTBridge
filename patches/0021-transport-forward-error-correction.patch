+impl InProgressPacket {
+    /// Rebuilds the one missing data shard of `group` from its parity, if exactly one is missing.
+    fn recover(&mut self, group: usize, max_shard: usize) -> bool {
+        let (groups, shards) = (self.fec_groups, self.shards_count);
+        if groups == 0 || group >= groups {
+            return false;
+        }
+        let Some(parity) = self.parity.get(&group) else {
