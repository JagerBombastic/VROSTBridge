--- /dev/null
+++ b/alvr/sockets/src/vrostbridge_fec.rs
@@ -0,0 +1,155 @@
+//! VROSTBridge: forward error correction for unreliable streams (video and game audio).
+//!
+//! The pinned stream socket drops a whole packet when one of its shards is lost, and a lost
+//! video packet costs a keyframe request: the picture freezes for several frames while the
+//! keyframe is asked for, encoded and sent. On a wired home network single shards go missing
+//! now and then (a few in a million on a healthy path), and every one of them showed up as a
+//! short stutter. A lost game-audio packet made the audio break up in the same way.
+//!
+//! With FEC the sender adds parity shards after each packet: the data shards are dealt into
+//! interleaved groups (shard i belongs to group i mod groups) and each parity shard is the XOR
+//! of one group, so the receiver rebuilds any one missing shard per group. Interleaving makes a
+//! burst of up to `groups` consecutive lost shards recoverable too.
+//!
+//! Parity travels on its own stream ID (the data stream's ID with the top bit set). A receiver
+//! without this code has no queue for that ID and discards those datagrams, exactly as it
+//! discards any unknown stream, so either side can be older than the other. Parity is off
+//! unless the embedding application turns it on for a stream.
+//!
+//! Parity datagram: the usual 14-byte shard prefix (stream ID | FEC_STREAM_FLAG, packet index,
+//! data shard count, group index), then the packet's payload size (u32 LE) and the number of
+//! groups (u32 LE), then the XOR of the group's shards (each zero-padded), as long as the
+//! longest shard: min(max shard size, payload size).
+
+use std::sync::atomic::{AtomicU32, AtomicU64, Ordering};
+
+/// Set on the stream ID of a parity datagram.
+pub const FEC_STREAM_FLAG: u16 = 0x8000;
+/// Payload size (u32) and group count (u32) before the parity bytes.
+pub const PARITY_HEADER_SIZE: usize = 8;
+/// Accepted group sizes (data shards per parity shard). 1 duplicates every shard.
+pub const MIN_FEC_GROUP: u32 = 1;
+pub const MAX_FEC_GROUP: u32 = 64;
+
+const STREAMS: usize = 16;
+
+static GROUP: [AtomicU32; STREAMS] = [const { AtomicU32::new(0) }; STREAMS];
+static PARITY_SENT: [AtomicU64; STREAMS] = [const { AtomicU64::new(0) }; STREAMS];
+static RECOVERED_PACKETS: [AtomicU64; STREAMS] = [const { AtomicU64::new(0) }; STREAMS];
+static RECOVERED_SHARDS: [AtomicU64; STREAMS] = [const { AtomicU64::new(0) }; STREAMS];
+
+/// Sends parity for `stream_id` with `group` data shards per parity shard; 0 (or an
+/// out-of-range value) turns it off. Returns whether parity is on.
+pub fn set_stream_fec(stream_id: u16, group: u32) -> bool {
+    let Some(slot) = GROUP.get(usize::from(stream_id)) else {
+        return false;
+    };
+    let on = (MIN_FEC_GROUP..=MAX_FEC_GROUP).contains(&group);
+    slot.store(if on { group } else { 0 }, Ordering::Relaxed);
+    on
+}
+
+/// Data shards per parity shard for this stream, when parity is on.
+pub fn stream_fec_group(stream_id: u16) -> Option<usize> {
+    let group = GROUP.get(usize::from(stream_id))?.load(Ordering::Relaxed);
+    (group > 0).then_some(group as usize)
+}
+
+/// Number of interleaved groups for a packet of `shards` data shards.
+pub fn fec_groups(shards: usize, group: usize) -> usize {
+    if shards == 0 || group == 0 {
+        0
+    } else {
+        shards.div_ceil(group)
+    }
+}
+
+/// Size of data shard `index` of a packet with `payload_size` bytes cut into `max_shard`-byte shards.
+pub fn shard_len(index: usize, payload_size: usize, max_shard: usize) -> usize {
+    payload_size.saturating_sub(index * max_shard).min(max_shard)
+}
+
+/// `dst ^= src` over the shorter of the two.
+pub fn xor_into(dst: &mut [u8], src: &[u8]) {
+    for (d, s) in dst.iter_mut().zip(src) {
+        *d ^= *s;
+    }
+}
+
+/// Parity datagrams sent for this stream (sender side).
+pub fn fec_parity_sent(stream_id: u16) -> u64 {
+    PARITY_SENT.get(usize::from(stream_id)).map_or(0, |c| c.load(Ordering::Relaxed))
+}
+
+/// Packets of this stream completed only thanks to parity (receiver side).
+pub fn fec_recovered_packets(stream_id: u16) -> u64 {
+    RECOVERED_PACKETS.get(usize::from(stream_id)).map_or(0, |c| c.load(Ordering::Relaxed))
+}
+
+/// Shards of this stream rebuilt from parity (receiver side).
+pub fn fec_recovered_shards(stream_id: u16) -> u64 {
+    RECOVERED_SHARDS.get(usize::from(stream_id)).map_or(0, |c| c.load(Ordering::Relaxed))
+}
+
+pub(crate) fn count_parity_sent(stream_id: u16) {
+    if let Some(c) = PARITY_SENT.get(usize::from(stream_id)) {
+        c.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+pub(crate) fn count_recovered(stream_id: u16, shards: u64) {
+    if let Some(c) = RECOVERED_PACKETS.get(usize::from(stream_id)) {
+        c.fetch_add(1, Ordering::Relaxed);
+    }
+    if let Some(c) = RECOVERED_SHARDS.get(usize::from(stream_id)) {
+        c.fetch_add(shards, Ordering::Relaxed);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn configuration_is_bounded_and_per_stream() {
+        assert!(set_stream_fec(9, 10));
+        assert_eq!(stream_fec_group(9), Some(10));
+        assert_eq!(stream_fec_group(8), None);
+        assert!(!set_stream_fec(9, 0));
+        assert_eq!(stream_fec_group(9), None);
+        assert!(!set_stream_fec(9, 65));
+        assert_eq!(stream_fec_group(9), None);
+        assert!(!set_stream_fec(200, 10));
+        assert_eq!(stream_fec_group(200), None);
+    }
+
+    #[test]
+    fn groups_and_shard_sizes() {
+        assert_eq!(fec_groups(0, 10), 0);
+        assert_eq!(fec_groups(1, 10), 1);
+        assert_eq!(fec_groups(10, 10), 1);
+        assert_eq!(fec_groups(11, 10), 2);
+        assert_eq!(fec_groups(48, 10), 5);
+        assert_eq!(shard_len(0, 3000, 1386), 1386);
+        assert_eq!(shard_len(2, 3000, 1386), 228);
+        assert_eq!(shard_len(3, 3000, 1386), 0);
+    }
+
+    #[test]
+    fn xor_rebuilds_a_missing_shard() {
+        let shards: [&[u8]; 3] = [&[1, 2, 3, 4], &[9, 8, 7, 6], &[5, 5]];
+        let mut parity = vec![0; 4];
+        for shard in shards {
+            xor_into(&mut parity, shard);
+        }
+        let mut rebuilt = parity.clone();
+        xor_into(&mut rebuilt, shards[0]);
+        xor_into(&mut rebuilt, shards[2]);
+        assert_eq!(rebuilt, shards[1]);
+        let mut last = parity;
+        xor_into(&mut last, shards[0]);
+        xor_into(&mut last, shards[1]);
+        assert_eq!(&last[..2], shards[2]);
+        assert_eq!(&last[2..], &[0, 0]);
+    }
+}
