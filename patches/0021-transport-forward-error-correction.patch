+mod vrostbridge_fec_tests {
+    //! VROSTBridge: the parity shards rebuild lost shards end to end over real UDP sockets. A relay
+    //! socket sits between writer and reader and drops chosen datagrams.
+    use super::*;
+    use std::{net::SocketAddr, sync::mpsc};
+
+    const MAX_PACKET: usize = 64; // 50-byte shards keep the test packets small
+
+    struct Link {
+        stream: u16,
+        writer: MultiplexedUdpWriter,
+        reader: MultiplexedUdpReader,
+        relay: UdpSocket,
+        reader_addr: SocketAddr,
+        queues: HashMap<u16, StreamRecvQueues>,
+        packets: mpsc::Receiver<ReconstructedPacket>,
+    }
+
+    fn make_link(stream: u16) -> Link {
+        let relay = UdpSocket::bind("127.0.0.1:0").unwrap();
+        relay.set_read_timeout(Some(Duration::from_millis(100))).unwrap();
+        let sender = UdpSocket::bind("127.0.0.1:0").unwrap();
+        sender.connect(relay.local_addr().unwrap()).unwrap();
+        let receiver = UdpSocket::bind("127.0.0.1:0").unwrap();
+        receiver.set_read_timeout(Some(Duration::from_millis(30))).unwrap();
+        let reader_addr = receiver.local_addr().unwrap();
+
+        let (packet_queue, packets) = mpsc::channel();
+        let (used_buffer_sender, used_buffer_receiver) = mpsc::channel();
+        for _ in 0..4 {
+            used_buffer_sender.send(vec![]).unwrap();
+        }
+        let mut queues = HashMap::new();
+        queues.insert(stream, StreamRecvQueues { used_buffer_sender, used_buffer_receiver, packet_queue });
+
+        Link {
+            stream,
+            writer: MultiplexedUdpWriter {
+                inner: sender,
+                max_packet_size: MAX_PACKET,
+                pacer: crate::Pacer::default(),
+                parity: vec![],
+                parity_datagram: vec![],
+            },
+            reader: MultiplexedUdpReader {
+                inner: receiver.into(),
+                max_packet_size: MAX_PACKET,
+                in_progress_packets: HashMap::new(),
+                parity_scratch: vec![],
+                last_finished: HashMap::new(),
+            },
+            relay,
+            reader_addr,
+            queues,
+            packets,
+        }
+    }
+
+    fn payload(len: usize, seed: u8) -> Vec<u8> {
+        (0..len).map(|i| (i as u8).wrapping_mul(31).wrapping_add(seed)).collect()
+    }
+
+    /// Sends one packet, forwards the datagrams `keep` accepts (in order, or reordered by
+    /// `order`), and returns what the reader delivered for that packet.
+    fn transfer(
+        link: &mut Link,
+        index: u32,
+        data: &[u8],
+        keep: impl Fn(&[u8]) -> bool,
+        reorder: bool,
+    ) -> Option<Vec<u8>> {
+        let mut buffer = vec![0; SHARD_PREFIX_SIZE];
+        buffer.extend_from_slice(data);
+        link.writer.send(link.stream, index, &mut buffer).unwrap();
+
+        let mut datagrams = vec![];
+        let mut scratch = [0u8; 2048];
+        while let Ok(size) = link.relay.recv(&mut scratch) {
+            datagrams.push(scratch[..size].to_vec());
+        }
+        if reorder {
+            datagrams.reverse();
+        }
+        for datagram in datagrams.iter().filter(|d| keep(d)) {
+            link.relay.send_to(datagram, link.reader_addr).unwrap();
+        }
+        for _ in 0..(datagrams.len() + 4) {
+            let _ = link.reader.recv(&link.queues);
+        }
+        let mut delivered = None;
+        while let Ok(packet) = link.packets.try_recv() {
+            if packet.index == index {
+                delivered = Some(packet.buffer[SHARD_PREFIX_SIZE..].to_vec());
+            }
+        }
+        delivered
+    }
+
+    fn is_parity(datagram: &[u8]) -> bool {
+        u16::from_le_bytes([datagram[0], datagram[1]]) & crate::FEC_STREAM_FLAG != 0
+    }
+
+    fn shard(datagram: &[u8]) -> usize {
+        u32::from_le_bytes(datagram[10..14].try_into().unwrap()) as usize
+    }
+
+    #[test]
+    fn one_lost_shard_per_group_is_rebuilt() {
+        let mut link = make_link(11);
+        crate::set_stream_fec(11, 4);
+        let data = payload(50 * 9 + 17, 3); // 10 shards, the last one short: 3 groups
+        let before = crate::fec_recovered_packets(11);
+        // Shards 1, 2 and 6 are in three different groups (i mod 3).
+        let got = transfer(&mut link, 1, &data, |d| is_parity(d) || ![1, 2, 6].contains(&shard(d)), false);
+        assert_eq!(got.as_deref(), Some(&data[..]));
+        assert_eq!(crate::fec_recovered_packets(11), before + 1);
+
+        // The short last shard (9) and the first shard (0, group 0) are rebuilt too.
+        let got = transfer(&mut link, 2, &data, |d| is_parity(d) || ![9].contains(&shard(d)), false);
+        assert_eq!(got.as_deref(), Some(&data[..]));
+        let got = transfer(&mut link, 3, &data, |d| is_parity(d) || shard(d) != 0, false);
+        assert_eq!(got.as_deref(), Some(&data[..]));
+        crate::set_stream_fec(11, 0);
+    }
+
+    #[test]
+    fn two_lost_shards_in_one_group_stay_lost_and_parity_alone_changes_nothing() {
+        let mut link = make_link(12);
+        crate::set_stream_fec(12, 4);
+        let data = payload(50 * 9 + 17, 5);
+        // Shards 0 and 3 are both in group 0 of 3: the packet cannot be rebuilt.
+        assert_eq!(transfer(&mut link, 1, &data, |d| is_parity(d) || ![0, 3].contains(&shard(d)), false), None);
+        // Losing only parity costs nothing; a later packet still arrives whole.
+        assert_eq!(transfer(&mut link, 2, &data, |d| !is_parity(d), false).as_deref(), Some(&data[..]));
+        assert_eq!(transfer(&mut link, 3, &data, |_| true, false).as_deref(), Some(&data[..]));
+        crate::set_stream_fec(12, 0);
+    }
+
+    #[test]
+    fn single_shard_packets_and_reordered_datagrams() {
+        let mut link = make_link(13);
+        crate::set_stream_fec(13, 2);
+        // One short shard: its parity is a copy, so losing the data still delivers it.
+        let small = payload(20, 9);
+        assert_eq!(transfer(&mut link, 1, &small, |d| is_parity(d), false).as_deref(), Some(&small[..]));
+        // Parity arriving before the data shards (reversed order) still rebuilds a lost one.
+        let data = payload(50 * 4 + 1, 11); // 5 shards, group size 2: 3 groups
+        assert_eq!(transfer(&mut link, 2, &data, |d| is_parity(d) || shard(d) != 2, true).as_deref(), Some(&data[..]));
+        crate::set_stream_fec(13, 0);
+    }
+
+    #[test]
+    fn duplicated_shards_survive_losing_all_data_and_late_parity_makes_no_duplicate() {
+        let mut link = make_link(14);
+        crate::set_stream_fec(14, 1); // one parity per shard: a copy (game audio)
+        let data = payload(50 + 30, 13); // two shards
+        assert_eq!(transfer(&mut link, 1, &data, |d| is_parity(d), false).as_deref(), Some(&data[..]));
+        // Everything arrives: the packet is delivered once, and its parity, arriving after it
+        // was finished, does not deliver it again.
+        let mut buffer = vec![0; SHARD_PREFIX_SIZE];
+        buffer.extend_from_slice(&data);
+        link.writer.send(14, 2, &mut buffer).unwrap();
+        let mut scratch = [0u8; 2048];
+        while let Ok(size) = link.relay.recv(&mut scratch) {
+            link.relay.send_to(&scratch[..size], link.reader_addr).unwrap();
+        }
+        for _ in 0..8 {
+            let _ = link.reader.recv(&link.queues);
+        }
+        let delivered: Vec<u32> = link.packets.try_iter().map(|packet| packet.index).collect();
+        assert_eq!(delivered, vec![2]);
+        crate::set_stream_fec(14, 0);
+    }
+
+    #[test]
+    fn without_parity_the_wire_format_is_unchanged() {
+        let mut link = make_link(15);
+        crate::set_stream_fec(15, 0);
+        let data = payload(50 * 3, 1);
+        let mut buffer = vec![0; SHARD_PREFIX_SIZE];
+        buffer.extend_from_slice(&data);
+        link.writer.send(15, 1, &mut buffer).unwrap();
+        let mut scratch = [0u8; 2048];
+        let mut sizes = vec![];
+        while let Ok(size) = link.relay.recv(&mut scratch) {
+            assert!(!is_parity(&scratch[..size]));
+            sizes.push(size);
+        }
+        assert_eq!(sizes, vec![MAX_PACKET; 3]);
+        // A receiver for whom the parity stream is unknown (an older client) discards parity.
+        crate::set_stream_fec(15, 3);
+        let mut other = make_link(15);
+        other.queues.clear();
+        let mut buffer = vec![0; SHARD_PREFIX_SIZE];
+        buffer.extend_from_slice(&data);
+        other.writer.send(15, 1, &mut buffer).unwrap();
+        let mut forwarded = 0;
+        while let Ok(size) = other.relay.recv(&mut scratch) {
+            other.relay.send_to(&scratch[..size], other.reader_addr).unwrap();
+            forwarded += 1;
+        }
+        assert_eq!(forwarded, 4); // 3 data shards and 1 parity shard
+        for _ in 0..forwarded {
+            assert!(other.reader.recv(&other.queues).is_err());
+        }
+        crate::set_stream_fec(15, 0);
+    }
+}
