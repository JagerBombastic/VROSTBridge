+    #[test]
+    fn the_comfort_zone_is_half_the_regions_half_size_and_never_below_the_dead_band() {
+        // Patch 0019: a 0.40 region (half-size 0.20) keeps still for gaze within 0.10.
+        assert!((movement_threshold(0.025, 0.5, 0.40) - 0.10).abs() < 1e-6);
