+        let [u, _] = eye_image_position(Quat::from_rotation_y((-24f32).to_radians()), &views[0]).unwrap();
+        assert!((u - region_middle(moved[0][0], size)).abs() <= zone);
+        assert!(size / 2.0 - zone >= size / 4.0 - 1e-6);
+    }
