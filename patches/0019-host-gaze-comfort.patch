+
+    #[test]
+    fn gaze_wandering_inside_the_zone_keeps_the_region_and_leaving_it_recentres() {
+        // Patch 0019. Views about 95 degrees wide: 0.10 of the image is about 10 degrees.
+        let views = [view(0.0), view(0.0)];
+        let defaults = [[0.0, 0.0], [0.0, 0.0]];
+        let start = Instant::now();
+        let mut state = DynamicFoveation::default();
+        let mut input = FrameInput {
+            gaze: Some((Quat::IDENTITY, start)),
+            views: &views,
+            geometry: geometry(),
+            defaults,
+            deadband: 0.025,
+            comfort: 0.5,
+            stale: Duration::from_millis(150),
+            hold: Duration::from_millis(1000),
+            now: start,
+            optical_centre: false,
+        };
+        let first = state.update(&input);
+        assert_eq!(state.moves, 1);
+        // Fixational movements and tracker noise of up to about 6 degrees, 75 frames a second
+        // for two seconds: before the zone (0.025 dead band) most of these moved the region.
+        let mut old = DynamicFoveation::default();
+        let mut old_input = FrameInput { comfort: 0.0, ..input };
+        old.update(&old_input);
+        for frame in 1..150u32 {
+            let t = frame as f32 * 0.37;
+            let yaw = 6.0 * t.sin();
+            let pitch = 4.0 * (1.7 * t).cos();
+            let gaze = Quat::from_rotation_y(yaw.to_radians()) * Quat::from_rotation_x(pitch.to_radians());
+            let now = start + Duration::from_millis(u64::from(frame) * 13);
+            input.gaze = Some((gaze, now));
+            input.now = now;
+            old_input.gaze = input.gaze;
+            old_input.now = now;
+            assert_eq!(state.update(&input), first, "frame {frame}");
+            old.update(&old_input);
+        }
+        assert_eq!(state.moves, 1);
+        assert!(old.moves > 40, "the dead band alone moved {} times", old.moves);
+        // A real change of gaze (a 20 degree saccade) moves the region, centred on the gaze.
+        let looked = Quat::from_rotation_y((-20f32).to_radians());
+        input.gaze = Some((looked, input.now));
+        let moved = state.update(&input);
+        assert_eq!(state.moves, 2);
+        assert_eq!(moved, gaze_shifts(looked, &views, &geometry()).unwrap());
+        // ...and small movements around the new point keep it there.
+        input.gaze = Some((Quat::from_rotation_y((-24f32).to_radians()), input.now));
+        assert_eq!(state.update(&input), moved);
+        // The sharp margin around the gaze never falls below half the region's half-size:
+        // every frame's gaze is within the zone of the region shown for it.
+        let size = geometry().center_size[0];
