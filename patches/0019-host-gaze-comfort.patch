+/// How far (in the eye image, 0..1) the gaze may be from the region's middle on one axis
+/// before the region moves: the comfort zone (a fraction of the region's half-size,
+/// patch 0019), and never less than the dead band.
+pub fn movement_threshold(deadband: f32, comfort: f32, center_size: f32) -> f32 {
+    let comfort = if comfort.is_finite() { comfort.clamp(0.0, 0.9) } else { 0.0 };
+    deadband.max(comfort * center_size.clamp(0.0, 1.0) / 2.0)
+}
