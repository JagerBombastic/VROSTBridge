+void VideoEncoderAMF::ResetAfterFailure() {
+    ++m_failures;
+    // Flush cancels queued work before references are released. The next accepted
+    // image requests a keyframe; no stale coded output crosses the reset.
+    m_recoveryPending = true;
+    m_nextRecoveryUs = VROSTBridgeNowUs() + 250000;
+    AMF_RESULT failed = AMF_OK;
+    for (auto& component : m_amfComponents) {
+        const AMF_RESULT result = component->Flush();
+        if (result != AMF_OK) failed = result;
+    }
+    if (failed != AMF_OK) {
+        // Retain ownership and retry at a bounded rate. Never declare a reset
+        // successful or reuse a texture while AMF refused to cancel its work.
+        throw MakeException("VROSTBridge AMF Flush failed: %d; retaining input ownership", failed);
+    }
+    m_pipeline->Reset();
+    for (auto& slot : m_inFlight) slot.surface = nullptr;
+    m_recoveryPending = false;
+    m_lastOutputProgressUs = VROSTBridgeNowUs();
+    RequestIDR();
+}
