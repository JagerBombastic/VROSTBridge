diff --git a/alvr/sockets/src/vrostbridge_pacing.rs b/alvr/sockets/src/vrostbridge_pacing.rs
new file mode 100644
index 00000000..7d7d4722
--- /dev/null
+++ b/alvr/sockets/src/vrostbridge_pacing.rs
@@ -0,0 +1,167 @@
+//! VROSTBridge: send-rate pacing for one unreliable stream (video).
+//!
+//! The pinned sender writes every shard of a video frame back to back, so a large
+//! frame leaves a fast host (for example on 10 GbE) as a burst at full line rate.
+//! When the client sits behind a slower link (1 or 2.5 GbE, or Wi-Fi), a router or
+//! access point must buffer most of that burst; small consumer buffers overflow and
+//! drop shards, and one missing shard costs a whole frame plus a keyframe request.
+//! Pacing the frame at, or just under, the client's link rate moves that queue into
+//! the host instead. The frame reaches the client no later than an unpaced burst
+//! would, because the slow link would have serialised it anyway, but nothing is lost.
+//!
+//! The wait is a yielding spin: Windows' default timer granularity can turn a 1 ms
+//! sleep into 15.6 ms, which would delay frames far more than it paces them. Pacing
+//! is off unless the embedding application configures it.
+
+use std::{
+    sync::atomic::{AtomicU32, AtomicU64, Ordering},
+    time::{Duration, Instant},
+};
+
+const NO_STREAM: u32 = u32::MAX;
+static PACED_STREAM: AtomicU32 = AtomicU32::new(NO_STREAM);
+static BYTES_PER_SECOND: AtomicU64 = AtomicU64::new(0);
+
+/// Lowest and highest accepted pacing rates. Values outside are rejected (pacing off).
+pub const MIN_PACING_MBPS: u32 = 50;
+pub const MAX_PACING_MBPS: u32 = 40_000;
+
+/// Credit kept after idle so the first shards of a frame leave immediately.
+const BURST_ALLOWANCE: Duration = Duration::from_micros(250);
+
+/// Paces `stream_id` at `mbps` megabits per second; 0 (or an out-of-range value) disables pacing.
+pub fn set_stream_pacing(stream_id: u16, mbps: u32) -> bool {
+    if (MIN_PACING_MBPS..=MAX_PACING_MBPS).contains(&mbps) {
+        BYTES_PER_SECOND.store(u64::from(mbps) * 1_000_000 / 8, Ordering::Relaxed);
+        PACED_STREAM.store(u32::from(stream_id), Ordering::Relaxed);
+        true
+    } else {
+        PACED_STREAM.store(NO_STREAM, Ordering::Relaxed);
+        BYTES_PER_SECOND.store(0, Ordering::Relaxed);
+        false
+    }
+}
+
+/// Pacing rate in bytes per second for this stream, if configured.
+pub fn stream_pacing(stream_id: u16) -> Option<f64> {
+    if PACED_STREAM.load(Ordering::Relaxed) != u32::from(stream_id) {
+        return None;
+    }
+    let rate = BYTES_PER_SECOND.load(Ordering::Relaxed);
+    (rate > 0).then_some(rate as f64)
+}
+
+/// Virtual-clock pacer: `next` is when the next byte may leave.
+#[derive(Default)]
+pub struct Pacer {
+    next: Option<Instant>,
+    pub waited: Duration,
+}
+
+impl Pacer {
+    /// Returns how long the caller must wait before sending `bytes` at `rate`
+    /// bytes per second, and books those bytes. `now` is injected for tests.
+    pub fn reserve(&mut self, bytes: usize, rate: f64, now: Instant) -> Duration {
+        let earliest = now.checked_sub(BURST_ALLOWANCE).unwrap_or(now);
+        let start = match self.next {
+            Some(next) if next > earliest => next,
+            _ => earliest,
+        };
+        let length = Duration::from_secs_f64(bytes as f64 / rate.max(1.0));
+        self.next = Some(start + length);
+        start.saturating_duration_since(now)
+    }
+
+    /// Blocks (yielding spin) until `bytes` may be sent.
+    pub fn pace(&mut self, bytes: usize, rate: f64) {
+        let now = Instant::now();
+        let wait = self.reserve(bytes, rate, now);
+        if wait.is_zero() {
+            return;
+        }
+        let deadline = now + wait;
+        while Instant::now() < deadline {
+            std::thread::yield_now();
+            std::hint::spin_loop();
+        }
+        self.waited += wait;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn configuration_is_bounded_and_per_stream() {
+        assert!(set_stream_pacing(3, 900));
+        assert_eq!(stream_pacing(3), Some(900e6 / 8.0));
+        assert_eq!(stream_pacing(4), None);
+        assert!(!set_stream_pacing(3, 10));
+        assert_eq!(stream_pacing(3), None);
+        assert!(!set_stream_pacing(3, 0));
+        assert_eq!(stream_pacing(3), None);
+    }
+
+    #[test]
+    fn a_frame_is_spread_at_the_configured_rate() {
+        let mut pacer = Pacer::default();
+        let rate = 1_000_000_000.0 / 8.0; // 1 Gbit/s
+        let start = Instant::now();
+        let mut now = start;
+        let mut sent_at = vec![];
+        // 300 KB frame in 1400-byte shards, sent as soon as allowed.
+        for _ in 0..215 {
+            now += pacer.reserve(1400, rate, now);
+            sent_at.push(now);
+        }
+        let span = *sent_at.last().unwrap() - start;
+        // 214 shards after the first at 11.2 us each, minus the burst allowance.
+        let expected = Duration::from_secs_f64(214.0 * 1400.0 / rate) - BURST_ALLOWANCE;
+        let error = span.as_secs_f64() - expected.as_secs_f64();
+        assert!(error.abs() < 20e-6, "span {span:?} expected {expected:?}");
+    }
+
+    #[test]
+    fn idle_time_does_not_build_credit_beyond_the_burst_allowance() {
+        let mut pacer = Pacer::default();
+        let rate = 125_000_000.0; // 1 Gbit/s
+        let mut now = Instant::now();
+        pacer.reserve(1400, rate, now);
+        now += Duration::from_millis(50); // idle between frames
+        // The burst allowance lets about 22 shards (250 us) leave at once, then pacing resumes.
+        let mut immediate = 0;
+        loop {
+            let wait = pacer.reserve(1400, rate, now);
+            if wait.is_zero() {
+                immediate += 1;
+            } else {
+                break;
+            }
+        }
+        assert!((20..=24).contains(&immediate), "{immediate}");
+    }
+
+    #[test]
+    fn backlog_carries_over_to_the_next_frame_when_frames_are_too_large() {
+        let mut pacer = Pacer::default();
+        let rate = 1_000_000.0; // deliberately slow: 1 MB/s
+        let now = Instant::now();
+        pacer.reserve(1_000_000, rate, now); // one second of data
+        let wait = pacer.reserve(1, rate, now + Duration::from_millis(10));
+        assert!(wait > Duration::from_millis(900));
+    }
+
+    #[test]
+    fn pace_waits_for_real() {
+        let mut pacer = Pacer::default();
+        let rate = 10_000_000.0; // 10 MB/s: 100 us per 1000 bytes
+        let start = Instant::now();
+        for _ in 0..20 {
+            pacer.pace(1000, rate);
+        }
+        let elapsed = start.elapsed();
+        assert!(elapsed >= Duration::from_micros(1600), "{elapsed:?}");
+        assert!(pacer.waited > Duration::ZERO);
+    }
+}
