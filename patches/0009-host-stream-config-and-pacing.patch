diff --git a/alvr/server_core/src/vrostbridge_stream.rs b/alvr/server_core/src/vrostbridge_stream.rs
new file mode 100644
index 00000000..d330093d
--- /dev/null
+++ b/alvr/server_core/src/vrostbridge_stream.rs
@@ -0,0 +1,131 @@
+//! VROSTBridge: per-session host stream options written by the VROSTBridge host
+//! companion next to session.json (`vrostbridge-stream.json`).
+//!
+//! These options must not change the ALVR session schema, because a newer client
+//! still has to talk to older hosts and the other way round. Instead the companion
+//! writes this small file before each session and the driver reads it when a client
+//! connects. A missing or unreadable file means every option is off, so ordinary
+//! ALVR use is unchanged.
+//!
+//! - `pacing_mbps`: spread each video frame at this rate (see alvr_sockets pacing).
+//! - `intra_refresh`: ask the hardware encoder to refresh the picture in stripes so a
+//!   lost packet heals within the refresh period instead of needing a keyframe.
+//! - `gaze_foveation`: move the foveated-encoding centre to where the user looks,
+//!   using the eye-gaze direction the client sends with tracking.
+
+use alvr_common::{info, parking_lot::RwLock};
+use std::path::Path;
+
+pub const CONFIG_FILE: &str = "vrostbridge-stream.json";
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct StreamConfig {
+    pub pacing_mbps: u32,
+    pub intra_refresh: bool,
+    pub gaze_foveation: bool,
+    /// Minimum centre movement, as a fraction of the eye image, before the centre moves.
+    pub gaze_deadband: f32,
+    /// Gaze samples older than this fall back to the fixed centre.
+    pub gaze_stale_ms: u32,
+}
+
+impl Default for StreamConfig {
+    fn default() -> Self {
+        Self {
+            pacing_mbps: 0,
+            intra_refresh: false,
+            gaze_foveation: false,
+            gaze_deadband: 0.025,
+            gaze_stale_ms: 150,
+        }
+    }
+}
+
+static CONFIG: RwLock<StreamConfig> = RwLock::new(StreamConfig {
+    pacing_mbps: 0,
+    intra_refresh: false,
+    gaze_foveation: false,
+    gaze_deadband: 0.025,
+    gaze_stale_ms: 150,
+});
+
+pub fn parse(text: &str) -> StreamConfig {
+    let mut config = StreamConfig::default();
+    let Ok(value) = serde_json::from_str::<serde_json::Value>(text) else {
+        return config;
+    };
+    if let Some(mbps) = value.get("pacing_mbps").and_then(|v| v.as_u64()) {
+        let mbps = mbps.min(u64::from(u32::MAX)) as u32;
+        if (alvr_sockets::MIN_PACING_MBPS..=alvr_sockets::MAX_PACING_MBPS).contains(&mbps) {
+            config.pacing_mbps = mbps;
+        }
+    }
+    config.intra_refresh = value.get("intra_refresh").and_then(|v| v.as_bool()).unwrap_or(false);
+    config.gaze_foveation = value.get("gaze_foveation").and_then(|v| v.as_bool()).unwrap_or(false);
+    if let Some(deadband) = value.get("gaze_deadband").and_then(|v| v.as_f64())
+        && deadband.is_finite()
+        && (0.0..=0.2).contains(&deadband)
+    {
+        config.gaze_deadband = deadband as f32;
+    }
+    if let Some(stale) = value.get("gaze_stale_ms").and_then(|v| v.as_u64())
+        && (20..=1000).contains(&stale)
+    {
+        config.gaze_stale_ms = stale as u32;
+    }
+    config
+}
+
+/// Reads the companion's file (absent → defaults), applies pacing to the video stream and keeps
+/// the options for the encoder and foveation code.
+pub fn load_and_apply(session_file: Option<&Path>, video_stream: u16) -> StreamConfig {
+    let config = session_file
+        .map(|path| path.with_file_name(CONFIG_FILE))
+        .and_then(|path| std::fs::read_to_string(path).ok())
+        .map(|text| parse(&text))
+        .unwrap_or_default();
+    *CONFIG.write() = config;
+    let paced = alvr_sockets::set_stream_pacing(video_stream, config.pacing_mbps);
+    info!(
+        "VROST_STREAM_CONFIG pacing_mbps={} paced={} intra_refresh={} gaze_foveation={} gaze_deadband={:.3} gaze_stale_ms={}",
+        config.pacing_mbps,
+        u8::from(paced),
+        u8::from(config.intra_refresh),
+        u8::from(config.gaze_foveation),
+        config.gaze_deadband,
+        config.gaze_stale_ms
+    );
+    config
+}
+
+pub fn current() -> StreamConfig {
+    *CONFIG.read()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn missing_or_invalid_values_are_off() {
+        assert_eq!(parse(""), StreamConfig::default());
+        assert_eq!(parse("not json"), StreamConfig::default());
+        let config = parse(r#"{"pacing_mbps": 5, "gaze_deadband": 3.0, "gaze_stale_ms": 5}"#);
+        assert_eq!(config.pacing_mbps, 0);
+        assert_eq!(config.gaze_deadband, StreamConfig::default().gaze_deadband);
+        assert_eq!(config.gaze_stale_ms, StreamConfig::default().gaze_stale_ms);
+    }
+
+    #[test]
+    fn valid_values_are_used() {
+        let config = parse(
+            r#"{"pacing_mbps": 920, "intra_refresh": true, "gaze_foveation": true,
+                "gaze_deadband": 0.04, "gaze_stale_ms": 120}"#,
+        );
+        assert_eq!(config.pacing_mbps, 920);
+        assert!(config.intra_refresh);
+        assert!(config.gaze_foveation);
+        assert!((config.gaze_deadband - 0.04).abs() < 1e-6);
+        assert_eq!(config.gaze_stale_ms, 120);
+    }
+}
