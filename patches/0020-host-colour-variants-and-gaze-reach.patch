+/// Head-relative gaze angles in degrees: yaw positive to the right, pitch positive up.
+pub fn gaze_angles(gaze: Quat) -> Option<[f32; 2]> {
+    let direction = gaze * Vec3::NEG_Z;
+    if !direction.is_finite() {
+        return None;
+    }
+    let yaw = direction.x.atan2(-direction.z).to_degrees();
+    let pitch = direction
+        .y
+        .atan2((direction.x * direction.x + direction.z * direction.z).sqrt())
+        .to_degrees();
+    (yaw.is_finite() && pitch.is_finite()).then_some([yaw, pitch])
+}
+
+/// Patch 0020: the extremes one logging window reached, for the diagnostic line only.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Reach {
+    /// Gaze yaw and pitch in degrees (`gaze_angles`), as [min, max] each.
+    pub yaw: [f32; 2],
+    pub pitch: [f32; 2],
+    /// Middle of the left eye's full-resolution region in its image (0..1, x right, y
+    /// down), as [min, max] each, over the frames the gaze placed it.
+    pub region_x: [f32; 2],
+    pub region_y: [f32; 2],
+    pub gaze_samples: u64,
+}
+
+impl Reach {
+    fn widen(range: &mut [f32; 2], value: f32, first: bool) {
+        if first {
+            *range = [value, value];
+        } else {
+            range[0] = range[0].min(value);
+            range[1] = range[1].max(value);
+        }
+    }
+
+    fn note(&mut self, angles: Option<[f32; 2]>, region: [f32; 2]) {
+        let first = self.gaze_samples == 0;
+        if let Some([yaw, pitch]) = angles {
+            Self::widen(&mut self.yaw, yaw, first);
+            Self::widen(&mut self.pitch, pitch, first);
+        }
+        Self::widen(&mut self.region_x, region[0], first);
+        Self::widen(&mut self.region_y, region[1], first);
+        self.gaze_samples += 1;
+    }
+}
