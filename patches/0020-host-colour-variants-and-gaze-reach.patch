diff --git a/alvr/server_openvr/src/vrostbridge_pair.rs b/alvr/server_openvr/src/vrostbridge_pair.rs
new file mode 100644
index 00000000..9a854b3e
--- /dev/null
+++ b/alvr/server_openvr/src/vrostbridge_pair.rs
@@ -0,0 +1,178 @@
+//! VROSTBridge (patch 0020, 1.0.0.6): what the host does to the two controllers while they are held still.
+//!
+//! In the 1.0.0.5 test the controller models, held still against each other, overlapped more on the
+//! stream than on the headset's own PC. Before SteamVR sees a controller the host changes its pose in
+//! two ways: the prediction (its velocities times the motion-to-photon latency) and the configured
+//! controller offsets (zero in VROSTBridge's profile). While both controllers are slower than
+//! `STILL_METRES_PER_SECOND` this compares the distance between them as received from the client with
+//! the distance as submitted to SteamVR, and keeps the largest move and turn the host gave either one,
+//! per `WINDOW`. Equal distances and no move mean the poses reach SteamVR as the headset PC tracked
+//! them. Only distances and angles are kept, never a position.
+
+use alvr_common::glam::{Quat, Vec3};
+use std::time::{Duration, Instant};
+
+pub const STILL_METRES_PER_SECOND: f32 = 0.03;
+pub const WINDOW: Duration = Duration::from_secs(5);
+
+/// One controller as received (position, orientation, linear velocity) and as submitted.
+#[derive(Clone, Copy, Debug)]
+pub struct Controller {
+    pub received: (Vec3, Quat, Vec3),
+    pub submitted: (Vec3, Quat),
+}
+
+#[derive(Default, Debug)]
+pub struct PairWindow {
+    still_frames: u64,
+    received_sum_mm: f64,
+    submitted_sum_mm: f64,
+    max_shift_mm: f32,
+    max_turn_deg: f32,
+    started: Option<Instant>,
+}
+
+/// One window's figures (what the diagnostic line carries).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct PairSummary {
+    pub still_frames: u64,
+    pub received_mm: f32,
+    pub submitted_mm: f32,
+    pub max_shift_mm: f32,
+    pub max_turn_deg: f32,
+}
+
+impl PairSummary {
+    pub fn line(&self) -> String {
+        format!(
+            "VROST_CONTROLLER_PAIR still_frames={} received_mm={:.1} submitted_mm={:.1} max_shift_mm={:.1} max_turn_deg={:.2}",
+            self.still_frames, self.received_mm, self.submitted_mm, self.max_shift_mm, self.max_turn_deg
+        )
+    }
+}
+
+fn finite(controller: &Controller) -> bool {
+    let (position, orientation, velocity) = controller.received;
+    position.is_finite()
+        && orientation.is_finite()
+        && velocity.is_finite()
+        && controller.submitted.0.is_finite()
+        && controller.submitted.1.is_finite()
+}
+
+impl PairWindow {
+    /// Notes one tracking frame with both controllers; returns the finished window's figures once
+    /// `WINDOW` has passed (None while it runs, or when neither was held still in it).
+    pub fn note(&mut self, pair: [Controller; 2], now: Instant) -> Option<PairSummary> {
+        let started = *self.started.get_or_insert(now);
+        let still = pair
+            .iter()
+            .all(|controller| finite(controller) && controller.received.2.length() < STILL_METRES_PER_SECOND);
+        if still {
+            self.still_frames += 1;
+            self.received_sum_mm += f64::from(pair[0].received.0.distance(pair[1].received.0)) * 1000.0;
+            self.submitted_sum_mm += f64::from(pair[0].submitted.0.distance(pair[1].submitted.0)) * 1000.0;
+            for controller in &pair {
+                let shift = controller.received.0.distance(controller.submitted.0) * 1000.0;
+                let turn = controller
+                    .received
+                    .1
+                    .normalize()
+                    .angle_between(controller.submitted.1.normalize())
+                    .to_degrees();
+                self.max_shift_mm = self.max_shift_mm.max(shift);
+                if turn.is_finite() {
+                    self.max_turn_deg = self.max_turn_deg.max(turn);
+                }
+            }
+        }
+        if now.saturating_duration_since(started) < WINDOW {
+            return None;
+        }
+        let summary = (self.still_frames > 0).then(|| PairSummary {
+            still_frames: self.still_frames,
+            received_mm: (self.received_sum_mm / self.still_frames as f64) as f32,
+            submitted_mm: (self.submitted_sum_mm / self.still_frames as f64) as f32,
+            max_shift_mm: self.max_shift_mm,
+            max_turn_deg: self.max_turn_deg,
+        });
+        *self = PairWindow {
+            started: Some(now),
+            ..Default::default()
+        };
+        summary
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn controller(x: f32, velocity: f32, submitted_x: f32, turn_deg: f32) -> Controller {
+        Controller {
+            received: (Vec3::new(x, 1.0, -0.3), Quat::IDENTITY, Vec3::new(velocity, 0.0, 0.0)),
+            submitted: (
+                Vec3::new(submitted_x, 1.0, -0.3),
+                Quat::from_rotation_y(turn_deg.to_radians()),
+            ),
+        }
+    }
+
+    #[test]
+    fn still_controllers_passed_through_unchanged_keep_their_distance() {
+        let start = Instant::now();
+        let mut window = PairWindow::default();
+        for frame in 0..300u64 {
+            let now = start + Duration::from_millis(frame * 4);
+            assert_eq!(
+                window.note([controller(-0.06, 0.01, -0.06, 0.0), controller(0.06, -0.01, 0.06, 0.0)], now),
+                None
+            );
+        }
+        let summary = window
+            .note(
+                [controller(-0.06, 0.0, -0.06, 0.0), controller(0.06, 0.0, 0.06, 0.0)],
+                start + WINDOW,
+            )
+            .unwrap();
+        assert_eq!(summary.still_frames, 301);
+        assert!((summary.received_mm - 120.0).abs() < 0.01 && (summary.submitted_mm - 120.0).abs() < 0.01);
+        assert!(summary.max_shift_mm < 0.01 && summary.max_turn_deg < 0.01);
+        assert!(summary.line().starts_with("VROST_CONTROLLER_PAIR still_frames=301 received_mm=120.0 submitted_mm=120.0"));
+    }
+
+    #[test]
+    fn an_offset_toward_each_other_shows_as_a_shorter_submitted_distance() {
+        let start = Instant::now();
+        let mut window = PairWindow::default();
+        window.note([controller(-0.06, 0.0, -0.055, 2.0), controller(0.06, 0.0, 0.055, 0.0)], start);
+        let summary = window
+            .note([controller(-0.06, 0.0, -0.055, 2.0), controller(0.06, 0.0, 0.055, 0.0)], start + WINDOW)
+            .unwrap();
+        assert!((summary.received_mm - 120.0).abs() < 0.01);
+        assert!((summary.submitted_mm - 110.0).abs() < 0.01);
+        assert!((summary.max_shift_mm - 5.0).abs() < 0.01);
+        assert!((summary.max_turn_deg - 2.0).abs() < 0.01);
+    }
+
+    #[test]
+    fn moving_controllers_are_left_out_and_a_window_without_stillness_says_nothing() {
+        let start = Instant::now();
+        let mut window = PairWindow::default();
+        window.note([controller(-0.06, 0.5, -0.03, 0.0), controller(0.06, 0.0, 0.06, 0.0)], start);
+        assert_eq!(
+            window.note([controller(-0.06, 0.5, -0.03, 0.0), controller(0.06, 0.0, 0.06, 0.0)], start + WINDOW),
+            None
+        );
+        // A new window starts after each report.
+        window.note([controller(-0.06, 0.0, -0.06, 0.0), controller(0.06, 0.0, 0.06, 0.0)], start + WINDOW);
+        let summary = window
+            .note([controller(-0.06, 0.0, -0.06, 0.0), controller(0.06, 0.0, 0.06, 0.0)], start + WINDOW * 2)
+            .unwrap();
+        assert_eq!(summary.still_frames, 2);
+        let mut broken = controller(-0.06, 0.0, -0.06, 0.0);
+        broken.submitted.0.x = f32::NAN;
+        window.note([broken, controller(0.06, 0.0, 0.06, 0.0)], start + WINDOW * 2);
+        assert_eq!(window.still_frames, 0, "a non-finite pose is not counted");
+    }
+}
