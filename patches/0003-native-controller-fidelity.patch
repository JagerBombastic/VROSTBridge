+#pragma once
+#include "bindings.h"
+#include <cmath>
+
+// Component lifetime follows activation, not optical tracking validity. This
+// shared helper is also exercised by the native regression tests without a
+// running SteamVR service.
+template<typename Mappings, typename Handles, typename Publish>
+bool VROSTBridgePublishControllerButton(bool activated, uint64_t path,
+    FfiButtonValue value, const Mappings& mappings, const Handles& handles,
+    Publish publish) {
+    if (!activated || (value.type != BUTTON_TYPE_BINARY && value.type != BUTTON_TYPE_SCALAR)) return false;
+    if (value.type == BUTTON_TYPE_SCALAR && !std::isfinite(value.scalar)) return false;
+    const auto mapping = mappings.find(path);
+    if (mapping == mappings.end()) return false;
+    bool sent = false;
+    for (auto component : mapping->second) {
+        const auto handle = handles.find(component);
+        if (handle == handles.end() || handle->second == 0) continue;
+        publish(handle->second, value);
+        sent = true;
+    }
+    return sent;
+}
