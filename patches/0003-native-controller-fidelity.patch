+#[cfg(test)]
+mod tests {
+    use super::*;
+    use alvr_common::Pose;
+    fn sample(at:u64, offset:f32) -> NativeOpenvrHandUpdate {
+        let mut ranges=[[Pose::IDENTITY;31];2];
+        for (r,range) in ranges.iter_mut().enumerate() {
+            for (b,bone) in range.iter_mut().enumerate() { bone.position.x=offset+r as f32/10.0+b as f32/100.0; }
+        }
+        NativeOpenvrHandUpdate::Sample(Box::new(NativeOpenvrHand {
+            sampled_at:Duration::from_millis(at),ranges,curls:Some([0.05,0.2,0.4,0.6,0.8]),
+        }))
+    }
+    #[test]
+    fn exact_channels_ranges_aux_and_hand_identity() {
+        let now=Instant::now();
+        let mut left=NativeHandHistory::new(8); let mut right=NativeHandHistory::new(8);
+        left.report(Duration::from_millis(104),sample(100,0.0),now);
+        right.report(Duration::from_millis(104),sample(100,0.5),now);
+        let l=left.get(Duration::from_millis(104),now).unwrap();
+        let r=right.get(Duration::from_millis(104),now).unwrap();
+        assert_eq!(l.curls,Some([0.05,0.2,0.4,0.6,0.8]));
+        assert!((l.ranges[1][30].position.x-0.4).abs()<1e-6);
+        assert!((r.ranges[0][30].position.x-0.8).abs()<1e-6);
+        assert_ne!(l.ranges[0][26].position,l.ranges[1][26].position);
+    }
+    #[test]
+    fn unchanged_stale_reordered_lost_and_disconnect() {
+        let now=Instant::now(); let mut h=NativeHandHistory::new(8);
+        h.report(Duration::from_millis(104),sample(100,0.0),now);
+        h.report(Duration::from_millis(108),NativeOpenvrHandUpdate::Unchanged(Duration::from_millis(100)),now);
+        assert!(h.get(Duration::from_millis(108),now).is_some());
+        h.report(Duration::from_millis(106),NativeOpenvrHandUpdate::Unavailable,now);
+        assert!(h.get(Duration::from_millis(108),now).is_some());
+        assert!(h.get(Duration::from_millis(108),now+Duration::from_millis(51)).is_none());
+        h.report(Duration::from_millis(152),NativeOpenvrHandUpdate::Unchanged(Duration::from_millis(100)),now);
+        assert!(h.get(Duration::from_millis(152),now).is_none());
+        h.report(Duration::from_millis(156),NativeOpenvrHandUpdate::Unchanged(Duration::from_millis(153)),now);
+        assert!(h.get(Duration::from_millis(156),now).is_none()); // lost Sample, no wrong cached fingers
+        h.report(Duration::from_millis(160),sample(159,0.0),now);
+        h.report(Duration::from_millis(164),NativeOpenvrHandUpdate::Unavailable,now);
+        assert!(h.get(Duration::from_millis(164),now).is_none());
+    }
+    #[test]
+    fn rejects_future_invalid_and_curl_corruption() {
+        let now=Instant::now(); let mut h=NativeHandHistory::new(8);
+        h.report(Duration::from_millis(100),sample(101,0.0),now);
+        assert!(h.get(Duration::from_millis(100),now).is_none());
+        let NativeOpenvrHandUpdate::Sample(mut s)=sample(104,0.0) else { panic!() };
+        s.curls=Some([0.0,0.1,f32::NAN,0.3,0.4]);
+        h.report(Duration::from_millis(104),NativeOpenvrHandUpdate::Sample(s),now);
+        assert!(h.get(Duration::from_millis(104),now).is_none());
+        let NativeOpenvrHandUpdate::Sample(mut s)=sample(108,0.0) else { panic!() };
+        s.ranges[1][30].position.x=3.0;
+        h.report(Duration::from_millis(108),NativeOpenvrHandUpdate::Sample(s),now);
+        assert!(h.get(Duration::from_millis(108),now).is_none());
+    }
+}
