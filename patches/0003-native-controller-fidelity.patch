+// VROSTBridge: bounded, timestamped native OpenVR hand cache. Freshness is
+// checked in the client's monotonic domain AND against host receipt time.
+use alvr_packets::{NativeOpenvrHand, NativeOpenvrHandUpdate};
+use std::{collections::VecDeque, sync::Arc, time::{Duration, Instant}};
+
+pub struct NativeHandHistory {
+    latest_poll: Option<Duration>,
+    cached: Option<Arc<NativeOpenvrHand>>,
+    history: VecDeque<(Duration, Instant, Option<Arc<NativeOpenvrHand>>)>,
+    capacity: usize,
+}
+impl NativeHandHistory {
+    pub fn new(capacity: usize) -> Self {
+        Self { latest_poll: None, cached: None, history: VecDeque::new(), capacity: capacity.max(1) }
+    }
+    pub fn report(&mut self, poll: Duration, update: NativeOpenvrHandUpdate, now: Instant) {
+        if self.latest_poll.is_some_and(|last| poll <= last) { return; }
+        self.latest_poll=Some(poll);
+        self.cached=match update {
+            NativeOpenvrHandUpdate::Sample(value) if value.valid_at(poll) => Some(Arc::from(value)),
+            NativeOpenvrHandUpdate::Unchanged(sampled_at) => self.cached.take().filter(|value|
+                value.sampled_at==sampled_at && value.valid_at(poll)),
+            _ => None,
+        };
+        self.history.push_front((poll, now, self.cached.clone()));
+        self.history.truncate(self.capacity);
+    }
+    pub fn get(&self, poll: Duration, now: Instant) -> Option<NativeOpenvrHand> {
+        let (_,received,value)=self.history.iter().find(|(timestamp,_,_)| *timestamp==poll)?;
+        let value=value.as_ref()?;
+        (now.saturating_duration_since(*received)<=NativeOpenvrHand::MAX_AGE && value.valid_at(poll))
+            .then(|| (**value).clone())
+    }
+}
