+#pragma once
+#include "bindings.h"
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+inline bool VROSTBridgeNativeHandIsFresh(const FfiNativeOpenvrHand* hand, uint64_t packetNs) {
+    return hand && packetNs >= hand->sampledAtNs && packetNs - hand->sampledAtNs <= 50000000ULL;
+}
+inline std::array<float,4> VROSTBridgeNativeFingerCurls(const FfiNativeOpenvrHand& hand) {
+    std::array<float,4> output{};
+    bool measured=hand.curlsValid;
+    for (float value:hand.curls) measured &= std::isfinite(value) && value>=0.0f && value<=1.0f;
+    for (int finger=0;finger<4;++finger) {
+        if (measured) output[finger]=hand.curls[finger+1];
+        else {
+            const int joint=7+5*finger;
+            const float estimate=(hand.ranges[1].jointRotations[joint].z
+                +hand.ranges[1].jointRotations[joint+1].z
+                +hand.ranges[1].jointRotations[joint+2].z)*0.67f;
+            output[finger]=std::isfinite(estimate) ? std::clamp(estimate,0.0f,1.0f) : 0.0f;
+        }
+    }
+    return output;
+}
