+/// VROSTBridge native OpenVR hand extension v1. Both ranges are PARENT-space
+/// OpenVR bones; they MUST NOT pass through OpenXR basis/retarget conversion.
+#[derive(Serialize, Deserialize, Clone, Debug)]
+pub struct NativeOpenvrHand {
+    pub sampled_at: Duration,
+    pub ranges: [[Pose; 31]; 2], // WithController, WithoutController
+    pub curls: Option<[f32; 5]>, // thumb, index, middle, ring, little
+}
+impl NativeOpenvrHand {
+    pub const MAX_AGE: Duration = Duration::from_millis(50);
+    pub fn valid_at(&self, poll_timestamp: Duration) -> bool {
+        poll_timestamp.checked_sub(self.sampled_at).is_some_and(|age| age <= Self::MAX_AGE)
+            && self.ranges.iter().flatten().all(|bone| {
+                let norm=bone.orientation.length_squared();
+                bone.position.is_finite() && bone.position.abs().max_element() <= 2.0
+                    && norm.is_finite() && (norm - 1.0).abs() <= 0.02
+            })
+            && self.curls.is_none_or(|c| c.iter().all(|v| v.is_finite() && (0.0..=1.0).contains(v)))
+    }
+}
+#[derive(Serialize, Deserialize, Clone, Debug, Default)]
+pub enum NativeOpenvrHandUpdate {
+    #[default]
+    Unavailable,
+    Unchanged(Duration),
+    Sample(Box<NativeOpenvrHand>),
+}
