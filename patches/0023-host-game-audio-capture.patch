+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn frames_f32(frames: &[&[f32]]) -> (Vec<u8>, usize) {
+        let channels = frames[0].len();
+        let data = frames.iter().flat_map(|f| f.iter().flat_map(|v| v.to_le_bytes())).collect();
+        (data, channels)
+    }
+
+    fn decode(out: &[u8]) -> Vec<[f32; 2]> {
+        out.chunks_exact(4)
+            .map(|c| {
+                [
+                    f32::from(i16::from_ne_bytes([c[0], c[1]])) / 32_767.0,
+                    f32::from(i16::from_ne_bytes([c[2], c[3]])) / 32_767.0,
+                ]
+            })
+            .collect()
+    }
+
+    #[test]
+    fn stereo_passes_through_and_silence_is_zero() {
+        let (data, channels) = frames_f32(&[&[0.25, -0.5], &[0.0, 0.75]]);
+        let weights = downmix_weights(channels, SPEAKER_FRONT_LEFT | SPEAKER_FRONT_RIGHT);
+        let mut out = vec![];
+        convert_to_stereo_i16(&data, 2, 8, channels, MixFormat::F32, &weights, false, &mut out);
+        let got = decode(&out);
+        assert!((got[0][0] - 0.25).abs() < 1e-3 && (got[0][1] + 0.5).abs() < 1e-3);
+        assert!((got[1][1] - 0.75).abs() < 1e-3);
+        // A packet flagged silent is zeros whatever its buffer held.
+        let mut silent = vec![];
+        convert_to_stereo_i16(&[0xAB; 16], 2, 8, channels, MixFormat::F32, &weights, true, &mut silent);
+        assert_eq!(silent, vec![0; 8]);
+        // So is a buffer shorter than it claims (never read past it).
+        let mut short = vec![];
+        convert_to_stereo_i16(&[0xAB; 4], 2, 8, channels, MixFormat::F32, &weights, false, &mut short);
+        assert_eq!(short, vec![0; 8]);
+    }
+
+    #[test]
+    fn five_point_one_folds_by_speaker_position() {
+        // FL FR FC LFE BL BR: every channel lands where it belongs.
+        let weights = downmix_weights(6, 0);
+        assert_eq!(weights.len(), 6);
+        let one = |index: usize| {
+            let mut frame = [0.0f32; 6];
+            frame[index] = 0.5;
+            let (data, _) = frames_f32(&[&frame]);
+            let mut out = vec![];
+            convert_to_stereo_i16(&data, 1, 24, 6, MixFormat::F32, &weights, false, &mut out);
+            decode(&out)[0]
+        };
+        assert!((one(0)[0] - 0.5).abs() < 1e-3 && one(0)[1].abs() < 1e-3); // front left
+        assert!((one(1)[1] - 0.5).abs() < 1e-3 && one(1)[0].abs() < 1e-3); // front right
+        assert!((one(2)[0] - 0.354).abs() < 2e-3 && (one(2)[1] - 0.354).abs() < 2e-3); // centre
+        assert!(one(3)[0].abs() < 1e-3 && one(3)[1].abs() < 1e-3); // low frequency
+        assert!((one(4)[0] - 0.354).abs() < 2e-3 && one(4)[1].abs() < 1e-3); // back left
+        assert!((one(5)[1] - 0.354).abs() < 2e-3 && one(5)[0].abs() < 1e-3); // back right
+        // The 7.1 mask of a real device (FL FR FC LFE BL BR SL SR).
+        let weights = downmix_weights(8, default_mask(8));
+        assert_eq!(weights[6], [MINUS_3_DB, 0.0]);
+        assert_eq!(weights[7], [0.0, MINUS_3_DB]);
+    }
+
+    #[test]
+    fn loud_surround_is_limited_softly_and_integer_formats_convert() {
+        let weights = downmix_weights(8, 0);
+        let frame = [0.9f32; 8];
+        let (data, _) = frames_f32(&[&frame]);
+        let mut out = vec![];
+        convert_to_stereo_i16(&data, 1, 32, 8, MixFormat::F32, &weights, false, &mut out);
+        let got = decode(&out)[0];
+        // Every channel near full scale sums far past it; the limit holds it at full scale.
+        assert!(got[0] <= 1.0 && got[0] > 0.95 && got[1] <= 1.0 && got[1] > 0.95, "{got:?}");
+        assert!(soft_limit(0.5) == 0.5 && soft_limit(-0.95) > -1.0 && soft_limit(5.0) <= 1.0);
+        // A float mix above full scale is limited, not wrapped or clipped hard.
+        let (data, _) = frames_f32(&[&[1.5, -3.0]]);
+        let mut out = vec![];
+        convert_to_stereo_i16(&data, 1, 8, 2, MixFormat::F32, &downmix_weights(2, 0), false, &mut out);
+        let got = decode(&out)[0];
+        assert!(got[0] > 0.98 && got[0] <= 1.0 && got[1] < -0.98 && got[1] >= -1.0, "{got:?}");
+
+        let pcm16: Vec<u8> = [16384i16, -16384].iter().flat_map(|v| v.to_le_bytes()).collect();
+        let mut out = vec![];
+        convert_to_stereo_i16(&pcm16, 1, 4, 2, MixFormat::I16, &downmix_weights(2, 0), false, &mut out);
+        let got = decode(&out)[0];
+        assert!((got[0] - 0.5).abs() < 1e-3 && (got[1] + 0.5).abs() < 1e-3);
+
+        let pcm24 = [0x00, 0x00, 0x40, 0x00, 0x00, 0xC0]; // +0.5, -0.5
+        let mut out = vec![];
+        convert_to_stereo_i16(&pcm24, 1, 6, 2, MixFormat::I24, &downmix_weights(2, 0), false, &mut out);
+        let got = decode(&out)[0];
+        assert!((got[0] - 0.5).abs() < 1e-3 && (got[1] + 0.5).abs() < 1e-3, "{got:?}");
+
+        let pcm32: Vec<u8> = [i32::MAX / 2, i32::MIN / 2].iter().flat_map(|v| v.to_le_bytes()).collect();
+        let mut out = vec![];
+        convert_to_stereo_i16(&pcm32, 1, 8, 2, MixFormat::I32, &downmix_weights(2, 0), false, &mut out);
+        let got = decode(&out)[0];
+        assert!((got[0] - 0.5).abs() < 1e-3 && (got[1] + 0.5).abs() < 1e-3, "{got:?}");
+    }
+
+    #[test]
+    fn mono_and_unknown_layouts() {
+        assert_eq!(downmix_weights(1, 0), vec![[MINUS_3_DB, MINUS_3_DB]]);
+        // A 2-channel mix with an empty mask is plain stereo.
+        assert_eq!(downmix_weights(2, 0), vec![[1.0, 0.0], [0.0, 1.0]]);
+        // More channels than the mask names: the extra ones are left out.
+        let weights = downmix_weights(4, SPEAKER_FRONT_LEFT | SPEAKER_FRONT_RIGHT);
+        assert_eq!(weights[2], [0.0, 0.0]);
+        assert_eq!(weights[3], [0.0, 0.0]);
+    }
+}
