+//! VROSTBridge: game-audio capture on the Windows host (WASAPI loopback).
+//!
+//! The pinned capture went through cpal, which hides the flags Windows attaches to each captured
+//! packet. A packet flagged AUDCLNT_BUFFERFLAGS_SILENT is to be treated as silence whatever its
+//! buffer holds; passing those bytes on can send stale sound or noise to the headset. A packet
+//! flagged AUDCLNT_BUFFERFLAGS_DATA_DISCONTINUITY means sound was lost because the capture fell
+//! behind, which nothing recorded. The capture thread ran at normal priority, so a game loading
+//! every core could hold it back. When nothing played, Windows sent nothing at all, so every sound
+//! after a quiet moment started with the client refilling its buffer. And a 5.1 mix was folded
+//! to stereo one channel off (front left went right, the centre went to the low-frequency slot).
+//!
+//! This capture reads the loopback stream itself: silent packets become zeros, discontinuities
+//! are counted, the thread runs in Windows' "Pro Audio" scheduling class, and a silent render
+//! stream on the same device keeps the audio engine running, so silence is sent as silence (the
+//! client's buffer stays filled and its timing steady). Surround mixes are folded to stereo by the
+//! speaker positions Windows reports, with a soft limit instead of hard clipping. When the device
+//! cannot be opened this way, the server falls back to the cpal capture.
+
+/// Speaker bits of WAVEFORMATEXTENSIBLE::dwChannelMask, in the order channels appear.
+pub const SPEAKER_FRONT_LEFT: u32 = 0x1;
+pub const SPEAKER_FRONT_RIGHT: u32 = 0x2;
+pub const SPEAKER_FRONT_CENTER: u32 = 0x4;
+pub const SPEAKER_LOW_FREQUENCY: u32 = 0x8;
+pub const SPEAKER_BACK_LEFT: u32 = 0x10;
+pub const SPEAKER_BACK_RIGHT: u32 = 0x20;
+pub const SPEAKER_FRONT_LEFT_OF_CENTER: u32 = 0x40;
+pub const SPEAKER_FRONT_RIGHT_OF_CENTER: u32 = 0x80;
+pub const SPEAKER_BACK_CENTER: u32 = 0x100;
+pub const SPEAKER_SIDE_LEFT: u32 = 0x200;
+pub const SPEAKER_SIDE_RIGHT: u32 = 0x400;
+
+const MINUS_3_DB: f32 = std::f32::consts::FRAC_1_SQRT_2;
+
+/// Windows' default speaker layout for a channel count without a mask (ksmedia.h KSAUDIO_SPEAKER_*).
+pub fn default_mask(channels: usize) -> u32 {
+    match channels {
+        1 => SPEAKER_FRONT_CENTER,
+        2 => SPEAKER_FRONT_LEFT | SPEAKER_FRONT_RIGHT,
+        3 => SPEAKER_FRONT_LEFT | SPEAKER_FRONT_RIGHT | SPEAKER_FRONT_CENTER,
+        4 => SPEAKER_FRONT_LEFT | SPEAKER_FRONT_RIGHT | SPEAKER_BACK_LEFT | SPEAKER_BACK_RIGHT,
+        5 => {
+            SPEAKER_FRONT_LEFT
+                | SPEAKER_FRONT_RIGHT
+                | SPEAKER_FRONT_CENTER
+                | SPEAKER_BACK_LEFT
+                | SPEAKER_BACK_RIGHT
+        }
+        6 => {
+            SPEAKER_FRONT_LEFT
+                | SPEAKER_FRONT_RIGHT
+                | SPEAKER_FRONT_CENTER
+                | SPEAKER_LOW_FREQUENCY
+                | SPEAKER_BACK_LEFT
+                | SPEAKER_BACK_RIGHT
+        }
+        7 => {
+            SPEAKER_FRONT_LEFT
+                | SPEAKER_FRONT_RIGHT
+                | SPEAKER_FRONT_CENTER
+                | SPEAKER_LOW_FREQUENCY
+                | SPEAKER_BACK_CENTER
+                | SPEAKER_SIDE_LEFT
+                | SPEAKER_SIDE_RIGHT
+        }
+        8 => {
+            SPEAKER_FRONT_LEFT
+                | SPEAKER_FRONT_RIGHT
+                | SPEAKER_FRONT_CENTER
+                | SPEAKER_LOW_FREQUENCY
+                | SPEAKER_BACK_LEFT
+                | SPEAKER_BACK_RIGHT
+                | SPEAKER_SIDE_LEFT
+                | SPEAKER_SIDE_RIGHT
+        }
+        _ => 0,
+    }
+}
+
+/// Left and right weights for every channel of a layout. Front left and right pass unchanged,
+/// centre and surround channels at -3 dB, the low-frequency channel is left out (as in ITU-R
+/// BS.775's stereo downmix). Channels beyond the mask's bits are left out too.
+pub fn downmix_weights(channels: usize, mask: u32) -> Vec<[f32; 2]> {
+    let mut weights = vec![[0.0f32, 0.0]; channels];
+    if channels == 1 {
+        weights[0] = [MINUS_3_DB, MINUS_3_DB];
+        return weights;
+    }
+    let mask = if mask == 0 || (mask.count_ones() as usize) < channels.min(2) {
+        default_mask(channels)
+    } else {
+        mask
+    };
+    let mut channel = 0;
+    for bit in 0..32 {
+        let speaker = 1u32 << bit;
+        if mask & speaker == 0 {
+            continue;
+        }
+        if channel >= channels {
+            break;
+        }
+        weights[channel] = match speaker {
+            SPEAKER_FRONT_LEFT => [1.0, 0.0],
+            SPEAKER_FRONT_RIGHT => [0.0, 1.0],
+            SPEAKER_FRONT_CENTER | SPEAKER_BACK_CENTER => [MINUS_3_DB, MINUS_3_DB],
+            SPEAKER_LOW_FREQUENCY => [0.0, 0.0],
+            SPEAKER_BACK_LEFT | SPEAKER_SIDE_LEFT | SPEAKER_FRONT_LEFT_OF_CENTER => [MINUS_3_DB, 0.0],
+            SPEAKER_BACK_RIGHT | SPEAKER_SIDE_RIGHT | SPEAKER_FRONT_RIGHT_OF_CENTER => {
+                [0.0, MINUS_3_DB]
+            }
+            // Height and other speakers: half to each side.
+            _ => [0.5, 0.5],
+        };
+        channel += 1;
+    }
+    weights
+}
+
+/// Soft limit: unchanged up to ±0.9, then a smooth curve that never passes ±1. Windows' float
+/// mix can go above full scale, and a surround fold adds channels together.
+pub fn soft_limit(x: f32) -> f32 {
+    const KNEE: f32 = 0.9;
+    let magnitude = x.abs();
+    if magnitude <= KNEE {
+        x
+    } else {
+        x.signum() * (KNEE + (1.0 - KNEE) * ((magnitude - KNEE) / (1.0 - KNEE)).tanh())
+    }
+}
+
+/// Sample formats a shared-mode mix can have.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MixFormat {
+    F32,
+    I16,
+    I24,
+    I32,
+}
+
+impl MixFormat {
+    pub fn bytes(self) -> usize {
+        match self {
+            MixFormat::I16 => 2,
+            MixFormat::I24 => 3,
+            MixFormat::F32 | MixFormat::I32 => 4,
+        }
+    }
+
+    fn sample(self, bytes: &[u8]) -> f32 {
+        match self {
+            MixFormat::F32 => f32::from_le_bytes([bytes[0], bytes[1], bytes[2], bytes[3]]),
+            MixFormat::I16 => f32::from(i16::from_le_bytes([bytes[0], bytes[1]])) / 32_768.0,
+            MixFormat::I24 => {
+                (i32::from_le_bytes([0, bytes[0], bytes[1], bytes[2]]) >> 8) as f32 / 8_388_608.0
+            }
+            MixFormat::I32 => {
+                i32::from_le_bytes([bytes[0], bytes[1], bytes[2], bytes[3]]) as f32 / 2_147_483_648.0
+            }
+        }
+    }
+}
+
+/// Converts `frames` captured frames (`stride` bytes each, `channels` samples of `format`) to the
+/// stereo 16-bit samples the client plays, appended to `out`. A silent packet becomes zeros.
+#[allow(clippy::too_many_arguments)]
+pub fn convert_to_stereo_i16(
+    data: &[u8],
+    frames: usize,
+    stride: usize,
+    channels: usize,
+    format: MixFormat,
+    weights: &[[f32; 2]],
+    silent: bool,
+    out: &mut Vec<u8>,
+) {
+    if silent || data.len() < frames * stride {
+        out.resize(out.len() + frames * 4, 0);
+        return;
+    }
+    out.reserve(frames * 4);
+    let size = format.bytes();
+    let stereo = channels == 2 && weights.len() == 2 && weights[0] == [1.0, 0.0] && weights[1] == [0.0, 1.0];
+    for frame in 0..frames {
+        let base = frame * stride;
+        let (left, right) = if stereo {
+            (format.sample(&data[base..]), format.sample(&data[base + size..]))
+        } else {
+            let (mut left, mut right) = (0.0f32, 0.0f32);
+            for (channel, weight) in weights.iter().enumerate().take(channels) {
+                if weight[0] == 0.0 && weight[1] == 0.0 {
+                    continue;
+                }
+                let value = format.sample(&data[base + channel * size..]);
+                left += value * weight[0];
+                right += value * weight[1];
+            }
+            (left, right)
+        };
+        for value in [left, right] {
+            let value = if value.is_finite() { soft_limit(value) } else { 0.0 };
+            let sample = (value * 32_767.0).round().clamp(-32_768.0, 32_767.0) as i16;
+            out.extend_from_slice(&sample.to_ne_bytes());
+        }
+    }
+}
