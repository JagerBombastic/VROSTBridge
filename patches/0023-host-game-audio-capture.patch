+#[cfg(windows)]
+pub use capture::LoopbackCapture;
+
+#[cfg(windows)]
+mod capture {
+    use super::*;
+    use alvr_common::{
+        anyhow::{Context, Result, bail},
+        info,
+    };
+    use alvr_sockets::StreamSender;
+    use cpal::{Device, traits::DeviceTrait};
+    use std::{
+        sync::Arc,
+        time::{Duration, Instant},
+    };
+    use windows::{
+        Win32::{
+            Foundation::{CloseHandle, HANDLE},
+            Media::Audio::{
+                AUDCLNT_BUFFERFLAGS_DATA_DISCONTINUITY, AUDCLNT_BUFFERFLAGS_SILENT,
+                AUDCLNT_SHAREMODE_SHARED, AUDCLNT_STREAMFLAGS_EVENTCALLBACK,
+                AUDCLNT_STREAMFLAGS_LOOPBACK, IAudioCaptureClient, IAudioClient, IAudioRenderClient,
+                IMMDevice, WAVEFORMATEX, WAVEFORMATEXTENSIBLE,
+            },
+            System::{
+                Com::{self, CLSCTX_ALL, COINIT_MULTITHREADED},
+                Threading::{
+                    AvRevertMmThreadCharacteristics, AvSetMmThreadCharacteristicsW, CreateEventW,
+                    WaitForSingleObject,
+                },
+            },
+        },
+        core::{GUID, w},
+    };
+
+    const WAVE_FORMAT_PCM: u16 = 1;
+    const WAVE_FORMAT_IEEE_FLOAT: u16 = 3;
+    const WAVE_FORMAT_EXTENSIBLE: u16 = 0xFFFE;
+    const SUBTYPE_PCM: GUID = GUID::from_u128(0x00000001_0000_0010_8000_00aa00389b71);
+    const SUBTYPE_IEEE_FLOAT: GUID = GUID::from_u128(0x00000003_0000_0010_8000_00aa00389b71);
+    /// 100 ms shared buffers (in 100 ns units); the capture reads at least every 10 ms.
+    const BUFFER_DURATION: i64 = 1_000_000;
+    const WAIT_MS: u32 = 10;
+    const REPORT_EVERY: Duration = Duration::from_secs(10);
+
+    struct Event(HANDLE);
+    impl Drop for Event {
+        fn drop(&mut self) {
+            unsafe { CloseHandle(self.0).ok() };
+        }
+    }
+
+    struct Layout {
+        format: MixFormat,
+        channels: usize,
+        rate: u32,
+        stride: usize,
+        mask: u32,
+    }
+
+    unsafe fn describe(mix: *const WAVEFORMATEX) -> Result<Layout> {
+        let header = unsafe { std::ptr::read_unaligned(mix) };
+        let tag = header.wFormatTag;
+        let bits = header.wBitsPerSample;
+        let (format, mask) = if tag == WAVE_FORMAT_EXTENSIBLE && header.cbSize >= 22 {
+            let extensible = unsafe { std::ptr::read_unaligned(mix as *const WAVEFORMATEXTENSIBLE) };
+            let sub = extensible.SubFormat;
+            let format = if sub == SUBTYPE_IEEE_FLOAT && bits == 32 {
+                MixFormat::F32
+            } else if sub == SUBTYPE_PCM {
+                match bits {
+                    16 => MixFormat::I16,
+                    24 => MixFormat::I24,
+                    32 => MixFormat::I32,
+                    _ => bail!("Unsupported PCM mix format: {bits} bits"),
+                }
+            } else {
+                bail!("Unsupported mix format subtype {sub:?}");
+            };
+            (format, extensible.dwChannelMask)
+        } else if tag == WAVE_FORMAT_IEEE_FLOAT && bits == 32 {
+            (MixFormat::F32, 0)
+        } else if tag == WAVE_FORMAT_PCM {
+            match bits {
+                16 => (MixFormat::I16, 0),
+                24 => (MixFormat::I24, 0),
+                32 => (MixFormat::I32, 0),
+                _ => bail!("Unsupported PCM mix format: {bits} bits"),
+            }
+        } else {
+            bail!("Unsupported mix format tag {tag}");
+        };
+        let channels = usize::from(header.nChannels);
+        let stride = usize::from(header.nBlockAlign);
+        if channels == 0 || channels > 32 || stride < channels * format.bytes() {
+            bail!("Unsupported mix layout: {channels} channels, {stride} bytes per frame");
+        }
+        Ok(Layout { format, channels, rate: header.nSamplesPerSec, stride, mask })
+    }
+
+    #[derive(Default)]
+    struct Stats {
+        packets: u64,
+        silent: u64,
+        discontinuities: u64,
+        frames: u64,
+        max_gap: Duration,
+    }
+
+    /// A loopback capture of one playback device, opened but not started.
+    pub struct LoopbackCapture {
+        device: Device,
+        client: IAudioClient,
+        capture: IAudioCaptureClient,
+        event: Option<Event>,
+        keep_alive: Option<(IAudioClient, IAudioRenderClient, u32)>,
+        layout: Layout,
+    }
+
+    impl LoopbackCapture {
+        /// Opens `device`'s mix for loopback capture. `expected_rate` is the rate the client was
+        /// told; a mix at another rate is refused (the caller then uses the cpal capture).
+        pub fn open(device: &Device, expected_rate: u32) -> Result<Self> {
+            unsafe {
+                // Fails harmlessly when this thread already joined the apartment.
+                Com::CoInitializeEx(None, COINIT_MULTITHREADED).ok().ok();
+                let imm_device: IMMDevice = crate::windows::get_windows_device(device)?;
+                let mix = {
+                    let client: IAudioClient = imm_device.Activate(CLSCTX_ALL, None)?;
+                    client.GetMixFormat()?
+                };
+                let result = Self::open_with(device, &imm_device, mix, expected_rate);
+                Com::CoTaskMemFree(Some(mix as _));
+                result
+            }
+        }
+
+        unsafe fn open_with(
+            device: &Device,
+            imm_device: &IMMDevice,
+            mix: *mut WAVEFORMATEX,
+            expected_rate: u32,
+        ) -> Result<Self> {
+            unsafe {
+                let layout = describe(mix)?;
+                if expected_rate != 0 && layout.rate != expected_rate {
+                    bail!("The mix runs at {} Hz, not the negotiated {expected_rate} Hz", layout.rate);
+                }
+                // Event-driven loopback needs Windows 10 1703 or later; older ones refuse the flag,
+                // and the capture then polls every WAIT_MS instead.
+                let mut event = None;
+                let mut client: IAudioClient = imm_device.Activate(CLSCTX_ALL, None)?;
+                let evented = client.Initialize(
+                    AUDCLNT_SHAREMODE_SHARED,
+                    AUDCLNT_STREAMFLAGS_LOOPBACK | AUDCLNT_STREAMFLAGS_EVENTCALLBACK,
+                    BUFFER_DURATION,
+                    0,
+                    mix,
+                    None,
+                );
+                if evented.is_ok() {
+                    let handle = Event(CreateEventW(None, false, false, None)?);
+                    client.SetEventHandle(handle.0)?;
+                    event = Some(handle);
+                } else {
+                    client = imm_device.Activate(CLSCTX_ALL, None)?;
+                    client
+                        .Initialize(AUDCLNT_SHAREMODE_SHARED, AUDCLNT_STREAMFLAGS_LOOPBACK, BUFFER_DURATION, 0, mix, None)
+                        .context("Loopback capture could not be opened")?;
+                }
+                let capture: IAudioCaptureClient = client.GetService()?;
+
+                // A silent render stream on the same device keeps the engine (and so the loopback)
+                // running while nothing else plays. Optional: without it, silence is not sent.
+                let keep_alive = (|| -> Result<(IAudioClient, IAudioRenderClient, u32)> {
+                    let render: IAudioClient = imm_device.Activate(CLSCTX_ALL, None)?;
+                    render.Initialize(AUDCLNT_SHAREMODE_SHARED, 0, BUFFER_DURATION, 0, mix, None)?;
+                    let frames = render.GetBufferSize()?;
+                    let service: IAudioRenderClient = render.GetService()?;
+                    Ok((render, service, frames))
+                })();
+                let keep_alive = match keep_alive {
+                    Ok(value) => Some(value),
+                    Err(e) => {
+                        info!("VROST_AUDIO_CAPTURE keep_alive=0 reason=\"{e}\"");
+                        None
+                    }
+                };
+                Ok(Self { device: device.clone(), client, capture, event, keep_alive, layout })
+            }
+        }
+
+        /// Captures and sends stereo 16-bit packets until `is_running` turns false or the device
+        /// goes away (an error: the caller opens the device again).
+        pub fn run(
+            self,
+            is_running: Arc<dyn Fn() -> bool + Send + Sync>,
+            mut sender: StreamSender<()>,
+            mute: bool,
+        ) -> Result<()> {
+            let layout = &self.layout;
+            let weights = downmix_weights(layout.channels, layout.mask);
+            unsafe {
+                if let Some((render, service, frames)) = &self.keep_alive {
+                    if service.GetBuffer(*frames).is_ok() {
+                        service.ReleaseBuffer(*frames, AUDCLNT_BUFFERFLAGS_SILENT.0 as u32).ok();
+                    }
+                    render.Start().ok();
+                }
+                let mut task = 0u32;
+                let mmcss = AvSetMmThreadCharacteristicsW(w!("Pro Audio"), &mut task).ok();
+                if mute && self.device.supports_output() {
+                    crate::windows::set_mute_windows_device(&self.device, true).ok();
+                }
+                let started = self.client.Start();
+                info!(
+                    "VROST_AUDIO_CAPTURE device=\"{}\" rate={} channels={} format={:?} mask=0x{:x} event={} keep_alive={} mmcss={}",
+                    self.device.name().unwrap_or_default(),
+                    layout.rate,
+                    layout.channels,
+                    layout.format,
+                    layout.mask,
+                    u8::from(self.event.is_some()),
+                    u8::from(self.keep_alive.is_some()),
+                    u8::from(mmcss.is_some()),
+                );
+
+                let mut stats = Stats::default();
+                let mut packet = Vec::<u8>::new();
+                let mut last_packet = Instant::now();
+                let mut last_report = Instant::now();
+                let result = match started {
+                    Err(e) => Err(e.into()),
+                    Ok(()) => loop {
+                        if !is_running() {
+                            break Ok(());
+                        }
+                        match &self.event {
+                            Some(event) => {
+                                WaitForSingleObject(event.0, WAIT_MS);
+                            }
+                            None => std::thread::sleep(Duration::from_millis(u64::from(WAIT_MS))),
+                        }
+
+                        if let Some((render, service, frames)) = &self.keep_alive {
+                            // Top the silent stream up so it never runs dry.
+                            if let Ok(padding) = render.GetCurrentPadding() {
+                                let free = frames.saturating_sub(padding);
+                                if free > 0 && service.GetBuffer(free).is_ok() {
+                                    service.ReleaseBuffer(free, AUDCLNT_BUFFERFLAGS_SILENT.0 as u32).ok();
+                                }
+                            }
+                        }
+
+                        let drained = (|| -> Result<()> {
+                            loop {
+                                if self.capture.GetNextPacketSize()? == 0 {
+                                    return Ok(());
+                                }
+                                let mut data: *mut u8 = std::ptr::null_mut();
+                                let mut frames = 0u32;
+                                let mut flags = 0u32;
+                                self.capture.GetBuffer(&mut data, &mut frames, &mut flags, None, None)?;
+                                let silent = flags & (AUDCLNT_BUFFERFLAGS_SILENT.0 as u32) != 0 || data.is_null();
+                                if flags & (AUDCLNT_BUFFERFLAGS_DATA_DISCONTINUITY.0 as u32) != 0 {
+                                    stats.discontinuities += 1;
+                                }
+                                packet.clear();
+                                let bytes = if silent {
+                                    &[][..]
+                                } else {
+                                    std::slice::from_raw_parts(data, frames as usize * layout.stride)
+                                };
+                                convert_to_stereo_i16(
+                                    bytes,
+                                    frames as usize,
+                                    layout.stride,
+                                    layout.channels,
+                                    layout.format,
+                                    &weights,
+                                    silent,
+                                    &mut packet,
+                                );
+                                self.capture.ReleaseBuffer(frames)?;
+                                if frames == 0 {
+                                    continue;
+                                }
+                                let now = Instant::now();
+                                stats.max_gap = stats.max_gap.max(now.saturating_duration_since(last_packet));
+                                last_packet = now;
+                                stats.packets += 1;
+                                stats.frames += u64::from(frames);
+                                stats.silent += u64::from(silent);
+                                sender.send_header_with_payload(&(), &packet).ok();
+                            }
+                        })();
+                        if let Err(e) = drained {
+                            break Err(e);
+                        }
+
+                        if last_report.elapsed() >= REPORT_EVERY {
+                            info!(
+                                "VROST_AUDIO_CAPTURE packets={} silent={} discontinuities={} frames={} max_gap_ms={:.1}",
+                                stats.packets,
+                                stats.silent,
+                                stats.discontinuities,
+                                stats.frames,
+                                stats.max_gap.as_secs_f64() * 1000.0
+                            );
+                            stats.max_gap = Duration::ZERO;
+                            last_report = Instant::now();
+                        }
+                    },
+                };
+
+                self.client.Stop().ok();
+                if let Some((render, _, _)) = &self.keep_alive {
+                    render.Stop().ok();
+                }
+                if mute && self.device.supports_output() {
+                    crate::windows::set_mute_windows_device(&self.device, false).ok();
+                }
+                if let Some(handle) = mmcss {
+                    AvRevertMmThreadCharacteristics(handle).ok();
+                }
+                result
+            }
+        }
+    }
+}
