+        // view (more field of view on the left), the mirrored right eye the other way.
+        let [u, _] = eye_image_position(Quat::IDENTITY, &views[0]).unwrap();
+        assert!(u > 0.5 && shifts[0][0] > 0.0 && shifts[1][0] < 0.0);
+        // Invalid views fall back to the negotiated centre.
+        let mut broken = views;
+        broken[0].fov.left = broken[0].fov.right;
+        let input = FrameInput { views: &broken, ..input };
+        assert_eq!(state.update(&input), defaults);
+    }
 }
