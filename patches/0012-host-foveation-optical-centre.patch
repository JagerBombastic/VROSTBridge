+    #[test]
+    fn optical_centre_follows_each_eyes_view() {
+        // Asymmetric fields of view, as on most headsets: straight ahead is off-centre.
+        let views = [view(0.0), view(0.0)];
+        let defaults = [[0.4, 0.1], [0.4, 0.1]];
+        let mut state = DynamicFoveation::default();
+        let input = FrameInput {
